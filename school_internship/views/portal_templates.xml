<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Onglet « Stages » : seulement pour les étudiants qui ont au moins une période de stage -->
  <template id="portal_nav_internships" inherit_id="school_attendance_qr.portal_nav_extra" name="Portail — lien Stages">
    <xpath expr="." position="inside">
      <t t-if="request.env['school.internship.period'].sudo().search_count([('student_id.user_id', '=', request.env.uid)])">
        <a href="/presence/stages" t-attf-class="#{'active' if active_nav == 'internships' else ''}">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" t-attf-stroke="#{'var(--ink)' if active_nav == 'internships' else 'var(--muted)'}" stroke-width="1.8"><rect x="4" y="6" width="16" height="14" rx="2"/><path d="M9 6V4h6v2M12 10v6M9 13h6"/></svg>
          Stages
        </a>
      </t>
    </xpath>
  </template>

  <template id="portal_internships" name="Portail — Mes stages">
    <t t-call="school_attendance_qr.portal_layout">
      <div class="pp-topbar"><div class="pp-h1">Mes stages</div></div>
      <div style="padding:20px; display:flex; flex-direction:column; gap:16px;">

        <t t-if="not period">
          <div class="pp-card" style="text-align:center; padding:26px 18px; color:var(--muted);">
            Aucune période de stage en cours aujourd'hui.
          </div>
        </t>
        <t t-else="">
          <div class="pp-card" style="text-align:center;">
            <div style="color:var(--gold); font-size:12px; font-weight:600; letter-spacing:.03em;">
              <t t-esc="'GARDE EN COURS' if shift else 'STAGE EN COURS'"/>
            </div>
            <div class="pp-h1" style="font-size:20px; margin-top:6px;" t-esc="period.site_id.name"/>
            <div style="color:var(--muted); font-size:13px; margin-top:3px;">
              <t t-if="period.site_id.specialty"><t t-esc="period.site_id.specialty"/> · </t>
              du <t t-esc="period.date_start.strftime('%d/%m')"/> au <t t-esc="period.date_end.strftime('%d/%m/%Y')"/>
            </div>
            <div t-if="shift" style="color:var(--muted); font-size:12.5px; margin-top:6px;">
              Entrée confirmée à <t t-esc="request.env['school.attendance.session'].fmt_local(shift.checkin_time, '%d/%m %Hh%M')"/>
            </div>
            <div id="ac_seal" class="ac-seal">
              <span class="ac-seal-label"><t t-esc="'Confirmer ma sortie' if shift else 'Confirmer mon entrée'"/></span>
            </div>
            <p id="ac_result" class="ac-result" style="display:none;"/>
            <p id="ac_result_sub" class="ac-result-sub" style="display:none;"/>
            <div style="color:var(--muted); font-size:11.5px; margin-top:8px;">
              Position et appareil vérifiés. Fonctionne aussi sans réseau (sous-sol, bloc) : la confirmation
              est envoyée au retour du réseau.
            </div>
          </div>
          <script type="text/javascript">
            document.addEventListener('DOMContentLoaded', function () {
              SchoolAttendance.initConfirmWidget('', '<t t-esc="phase_hint"/>', {
                confirmUrl: '/presence/stages/confirmer', offline: { target: 'internship' },
              });
            });
          </script>

          <t t-if="shift">
            <div t-if="check" class="pp-card" style="border:2px solid var(--brick); text-align:center;">
              <div style="color:var(--brick); font-size:12px; font-weight:700;">CONTRÔLE DE PRÉSENCE</div>
              <div style="font-size:13px; margin:6px 0 10px;">Confirmez avec votre empreinte avant
                <b t-esc="request.env['school.attendance.session'].fmt_local(check.deadline)"/>.</div>
              <button type="button" id="tr_check" class="btn" style="background:var(--brick); color:#fff; border-radius:10px; font-weight:600; width:100%;">
                Je suis présent(e) — confirmer
              </button>
              <p id="tr_check_msg" class="ac-result" style="display:none; font-size:13px;"/>
            </div>
            <div id="tr_box" class="pp-card" t-att-data-minutes="ping_minutes" style="font-size:12.5px;">
              <div style="font-weight:600;">Suivi de présence pendant la garde</div>
              <div id="tr_status" style="color:var(--muted); margin-top:3px;">Démarrage du suivi GPS…</div>
              <div style="color:var(--muted); font-size:11.5px; margin-top:6px;">
                Gardez cette page ouverte pendant votre garde : votre position est vérifiée régulièrement et des
                contrôles avec empreinte sont demandés aux heures de pause
                (<t t-esc="period.site_id.check_times or 'aucun'"/>). Écran verrouillé, le suivi s'interrompt.
              </div>
            </div>
            <script type="text/javascript" src="/school_internship/static/src/js/tracking.js"></script>
          </t>

          <div class="pp-card">
            <div style="display:flex; align-items:center; justify-content:space-between;">
              <div style="font-size:13.5px; font-weight:600;">Heures cliniques validées</div>
              <div class="pp-h1" style="font-size:18px;"><t t-esc="'%g' % period.validated_hours"/> / <t t-esc="'%g' % period.required_hours"/> h</div>
            </div>
            <div style="height:7px; border-radius:4px; background:var(--mist); margin-top:10px; overflow:hidden;">
              <div t-attf-style="height:100%%; width:#{period.progress}%%; background:var(--green);"/>
            </div>
            <div style="color:var(--muted); font-size:12px; margin-top:8px;">
              <t t-esc="'%g' % period.pending_hours"/> h en attente de validation par le superviseur
            </div>
          </div>

          <div t-if="recent">
            <div style="font-size:12px; font-weight:600; color:var(--muted); margin:4px 0 8px 4px;">DERNIÈRES GARDES</div>
            <div class="pp-card" style="padding:0; overflow:hidden;">
              <t t-foreach="recent" t-as="g">
                <div style="display:flex; justify-content:space-between; gap:8px; padding:12px 14px; border-bottom:1px solid var(--line); font-size:13px;">
                  <div>
                    <div style="font-weight:600;" t-esc="request.env['school.attendance.session'].fmt_local(g.checkin_time, '%d/%m %Hh%M')"/>
                    <div style="color:var(--muted); font-size:12px;">
                      <t t-if="g.checkout_time"><t t-esc="'%g' % g.duration_hours"/> h</t>
                      <t t-else="">en cours</t>
                      <t t-if="g.offline"> · hors ligne</t>
                    </div>
                  </div>
                  <span t-if="g.is_validated" style="color:var(--green); font-size:12px; font-weight:600;">Validée</span>
                  <span t-elif="g.checkout_state == 'rejected' or g.checkin_state == 'rejected'" style="color:var(--brick); font-size:12px; font-weight:600;">Refusée</span>
                  <span t-elif="g.checkout_time" style="color:var(--amber); font-size:12px; font-weight:600;">À valider</span>
                </div>
              </t>
            </div>
          </div>
        </t>

        <t t-set="validated" t-value="periods.filtered(lambda p: p.status == 'validated')"/>
        <div t-if="validated">
          <div style="font-size:12px; font-weight:600; color:var(--muted); margin:4px 0 8px 4px;">RELEVÉS D'HEURES</div>
          <div class="pp-card" style="padding:0; overflow:hidden;">
            <t t-foreach="validated" t-as="p">
              <a t-attf-href="/presence/stages/releve/#{p.id}" style="display:flex; justify-content:space-between; padding:12px 14px; border-bottom:1px solid var(--line); font-size:13px;">
                <span><t t-esc="p.site_id.name"/> · <t t-esc="'%g' % p.validated_hours"/> h</span>
                <span style="color:var(--muted);">PDF</span>
              </a>
            </t>
          </div>
        </div>
      </div>
    </t>
  </template>

  <!-- Écran du superviseur : même esprit que l'écran du responsable des relais -->
  <template id="portal_supervisor" name="Portail — Validation des gardes">
    <t t-call="school_attendance_qr.portal_layout">
      <div class="pp-topbar">
        <div class="pp-h1">Gardes à valider</div>
        <div style="color:#B9C0D4; font-size:12.5px; margin-top:3px;" t-esc="teacher.name"/>
      </div>
      <div style="padding:20px; display:flex; flex-direction:column; gap:14px;">
        <div class="pp-card" style="font-size:12.5px; color:var(--muted); line-height:1.5;">
          Vous validez avec <b>votre</b> empreinte. Seules les gardes doublement validées comptent dans les heures
          de l'étudiant. Sans réseau, la validation est gardée sur ce téléphone et envoyée au retour du réseau.
        </div>
        <t t-if="not pending">
          <div class="pp-card" style="text-align:center; padding:26px 18px; color:var(--muted);">Aucune garde en attente.</div>
        </t>
        <t t-foreach="pending" t-as="g">
          <div class="pp-card sv-row" t-att-data-id="g.id" style="display:flex; flex-direction:column; gap:8px;">
            <div style="display:flex; justify-content:space-between; gap:8px;">
              <div>
                <div style="font-size:14px; font-weight:600;" t-esc="g.student_id.name"/>
                <div style="font-size:12px; color:var(--muted);">
                  <t t-esc="g.site_id.name"/> · <t t-esc="request.env['school.attendance.session'].fmt_local(g.checkin_time, '%d/%m %Hh%M')"/>
                  → <t t-esc="request.env['school.attendance.session'].fmt_local(g.checkout_time, '%d/%m %Hh%M')"/>
                </div>
              </div>
              <div class="pp-h1" style="font-size:17px; white-space:nowrap;"><t t-esc="'%g' % g.duration_hours"/> h</div>
            </div>
            <div t-if="g.flag_reason" style="font-size:12px; color:var(--amber);" t-esc="g.flag_reason"/>
            <div style="display:flex; gap:8px; align-items:center;">
              <label style="font-size:12px; color:var(--muted);">Évaluation (facultative)</label>
              <select name="rating" class="form-select form-select-sm" style="width:auto;">
                <option value="">—</option>
                <option value="1">1</option><option value="2">2</option><option value="3">3</option>
                <option value="4">4</option><option value="5">5</option>
              </select>
            </div>
            <textarea name="comment" class="form-control" rows="2" placeholder="Commentaire (facultatif)"/>
            <button type="button" class="sv-validate btn" style="background:var(--ink); color:#fff; border-radius:10px; font-weight:600;">
              Valider avec mon empreinte
            </button>
            <p class="sv-msg ac-result" style="display:none; font-size:13px;"/>
          </div>
        </t>
        <a href="/odoo" style="text-align:center; font-size:13px; color:var(--muted);">Retour à l'espace enseignant</a>
      </div>
      <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {
          var SA = window.SchoolAttendance, P = window.SchoolPwa;
          function show(el, cls, text) { el.className = 'sv-msg ac-result ' + cls; el.textContent = text; el.style.display = 'block'; }
          document.querySelectorAll('.sv-row').forEach(function (row) {
            var btn = row.querySelector('.sv-validate'), msg = row.querySelector('.sv-msg');
            btn.addEventListener('click', function () {
              var data = { attendance_id: row.dataset.id, rating: row.querySelector('[name=rating]').value || null,
                           comment: row.querySelector('[name=comment]').value || null };
              btn.disabled = true; show(msg, '', 'Vérification…');
              P.probe().then(function (state) {
                if (state === 'offline') {
                  return P.confirmOffline(Object.assign({ target: 'internship_validation' }, data), { gps: false })
                    .then(function () { show(msg, 'ac-warn', 'Validation enregistrée hors ligne : elle sera envoyée au retour du réseau.'); });
                }
                return SA.runWebAuthnCeremony('/presence/stages/superviseur/options').then(function (wa) {
                  return SA.rpcCall('/presence/stages/valider', Object.assign(data, { webauthn_mode: wa.mode, webauthn_credential: wa.credential }));
                }).then(function (res) {
                  res = res || {};
                  if (res.error) { btn.disabled = false; show(msg, 'ac-err', res.error); return; }
                  show(msg, 'ac-ok', 'Garde validée.');
                  btn.style.display = 'none';
                });
              }).catch(function (err) { btn.disabled = false; show(msg, 'ac-err', err.message || String(err)); });
            });
          });
        });
      </script>
    </t>
  </template>

  <template id="portal_supervisor_denied" name="Portail — Superviseur non reconnu">
    <t t-call="school_attendance_qr.portal_layout">
      <div class="pp-topbar"><div class="pp-h1">Gardes à valider</div></div>
      <div style="padding:22px 20px;">
        <div class="pp-card" style="text-align:center; color:var(--muted);">
          Cet écran est réservé aux superviseurs désignés d'un site de stage.
        </div>
      </div>
    </t>
  </template>

</odoo>
