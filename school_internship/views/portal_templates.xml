<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Les stages sont désormais un sous-onglet d'Études, pas un onglet séparé. -->
  <template id="portal_nav_internships" inherit_id="school_attendance_qr.portal_nav_extra" name="Stages — pas d'ajout de nav">
    <xpath expr="." position="inside"/>
  </template>

  <template id="portal_internships" name="Mes stages">
    <t t-call="school_attendance_qr.portal_shell">
      <t t-set="page_title">Mes stages</t>
      <t t-set="active_nav">studies</t>

      <header class="topbar">
        <h1>Études</h1>
        <t t-call="school_academic.portal_studies_segmented">
          <t t-set="sub" t-value="'stages'"/>
          <t t-set="has_internship" t-value="True"/>
        </t>
      </header>

      <div class="page">
        <t t-if="not period">
          <div class="card" style="text-align:center; padding:28px; color:var(--muted);">Aucune période de stage en cours aujourd'hui.</div>
        </t>

        <t t-elif="check">
          <section class="card spotlight" style="border:2px solid var(--bad); display:flex; flex-direction:column; gap:10px;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <span class="eyebrow bad">CONTRÔLE DE PRÉSENCE</span>
              <span class="eyebrow bad" id="ac_countdown" t-att-data-close-at="check.deadline.isoformat() + 'Z'"/>
            </div>
            <div style="font-size:13.5px;">Pause de <t t-esc="request.env['school.attendance.session'].fmt_local(check.due_at, '%Hh%M')"/> : confirmez votre présence avec votre empreinte.</div>
            <button type="button" id="tr_check" class="btn-primary danger">Je suis présent(e) — confirmer</button>
            <p id="tr_check_msg" class="ac-result" style="display:none;"/>
          </section>
        </t>

        <t t-if="period">
          <section class="card spotlight" style="background:var(--night); color:#fff; display:flex; flex-direction:column; gap:12px;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
              <div>
                <t t-if="shift">
                  <div class="eyebrow" style="color:#E0B66A;">GARDE EN COURS</div>
                </t>
                <t t-else="">
                  <div class="eyebrow" style="color:#9ED3B5;">PÉRIODE DE STAGE</div>
                </t>
                <div style="font-family:'Source Serif 4',serif; font-size:20px; font-weight:700; margin-top:4px;" t-esc="period.site_id.name"/>
                <t t-if="shift">
                  <div style="font-size:12.5px; color:#C4CAD8;">Depuis <t t-esc="request.env['school.attendance.session'].fmt_local(shift.checkin_time, '%Hh%M')"/></div>
                </t>
                <t t-else="">
                  <div style="font-size:12.5px; color:#C4CAD8;">
                    <t t-if="period.site_id.specialty"><t t-esc="period.site_id.specialty"/> · </t>
                    du <t t-esc="period.date_start.strftime('%d/%m')"/> au <t t-esc="period.date_end.strftime('%d/%m/%Y')"/>
                  </div>
                </t>
              </div>
            </div>
            <div id="tr_box" t-att-data-minutes="ping_minutes" t-att-data-zones="zones_json" style="display:flex; align-items:center; gap:8px; font-size:12.5px; color:#9ED3B5;">
              <span class="dot ok live-dot"/>
              <span id="tr_status">Démarrage du suivi GPS…</span>
            </div>
            <button type="button" id="ac_seal" class="btn-primary" style="background:#fff; color:var(--ink);">
              <span class="ac-seal-label"><t t-esc="'Confirmer ma sortie' if shift else 'Confirmer mon entrée'"/></span>
            </button>
            <p id="ac_result" class="ac-result" style="display:none;"/>
            <p id="ac_result_sub" class="ac-result-sub" style="display:none;"/>
          </section>
          <script type="text/javascript">
            document.addEventListener('DOMContentLoaded', function () {
              SchoolAttendance.initConfirmWidget('', '<t t-esc="phase_hint"/>', {
                confirmUrl: '/presence/stages/confirmer', offline: { target: 'internship' },
                zones: <t t-out="zones_json"/>, place: 'du site de stage',
              });
            });
          </script>

          <section class="card" style="display:flex; flex-direction:column; gap:8px;">
            <div style="display:flex; justify-content:space-between; align-items:baseline;">
              <span style="font-size:14px; font-weight:700;">Heures cliniques validées</span>
              <span style="font-family:'Source Serif 4',serif; font-size:19px; font-weight:700;">
                <t t-esc="'%g' % period.validated_hours"/> / <t t-esc="'%g' % period.required_hours"/> h
              </span>
            </div>
            <t t-set="validated_pct" t-value="min(100, period.progress) if period.required_hours else 0"/>
            <t t-set="pending_pct" t-value="min(100 - validated_pct, (period.pending_hours / period.required_hours * 100) if period.required_hours else 0)"/>
            <div class="progress">
              <span t-attf-style="width:#{validated_pct}%; background:var(--ok);"/>
              <span t-attf-style="width:#{pending_pct}%; background:var(--warn);"/>
            </div>
            <div style="display:flex; gap:14px; font-size:12px; color:var(--muted);">
              <span style="display:flex; align-items:center; gap:5px;"><span class="dot ok"/>Validées</span>
              <span style="display:flex; align-items:center; gap:5px;"><span class="dot warn"/><t t-esc="'%g' % period.pending_hours"/> h à valider</span>
            </div>
          </section>

          <t t-if="recent">
            <div class="section-label">DERNIÈRES GARDES</div>
            <div class="card-row">
              <t t-foreach="recent" t-as="g">
                <div class="list-row">
                  <div class="main">
                    <div class="title"><t t-esc="request.env['school.attendance.session'].fmt_local(g.checkin_time, '%d/%m · %Hh%M')"/></div>
                    <div class="sub">
                      <t t-if="g.checkout_time"><t t-esc="'%g' % g.duration_hours"/> h</t>
                      <t t-else="">en cours</t>
                      <t t-if="g.offline"> · hors ligne</t>
                    </div>
                  </div>
                  <span t-if="g.is_validated" class="badge ok">Validée</span>
                  <span t-elif="g.checkin_state == 'rejected' or g.checkout_state == 'rejected'" class="badge bad">Refusée</span>
                  <span t-elif="g.checkout_time" class="badge warn">À valider</span>
                </div>
              </t>
            </div>
          </t>
        </t>
      </div>

      <t t-if="shift">
        <script type="text/javascript" src="/school_internship/static/src/js/tracking.js"></script>
      </t>
    </t>
  </template>

  <template id="portal_supervisor" name="Portail — Validation des gardes">
    <t t-call="school_attendance_qr.portal_shell">
      <t t-set="page_title">Gardes à valider</t>

      <header class="topbar">
        <div class="topbar-row">
          <a href="/odoo" class="icon-btn" aria-label="Retour">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
          </a>
          <h1 style="font-size:22px; margin:0; flex:1;">Gardes à valider</h1>
          <span style="width:40px;"/>
        </div>
        <div class="topbar-sub" t-esc="teacher.name"/>
      </header>

      <div class="page">
        <div class="card" style="font-size:12.5px; color:var(--muted); line-height:1.5;">
          Vous validez avec <b>votre</b> empreinte. Seules les gardes doublement validées comptent dans les heures de l'étudiant.
        </div>
        <t t-if="not pending">
          <div class="card" style="text-align:center; color:var(--muted); padding:28px;">Aucune garde en attente.</div>
        </t>
        <t t-foreach="pending" t-as="g">
          <div class="card sv-row" t-att-data-id="g.id" style="display:flex; flex-direction:column; gap:8px;">
            <div style="display:flex; justify-content:space-between; gap:8px;">
              <div>
                <div style="font-size:14px; font-weight:600;" t-esc="g.student_id.name"/>
                <div style="font-size:12px; color:var(--muted);">
                  <t t-esc="g.site_id.name"/> ·
                  <t t-esc="request.env['school.attendance.session'].fmt_local(g.checkin_time, '%d/%m %Hh%M')"/>
                  → <t t-esc="request.env['school.attendance.session'].fmt_local(g.checkout_time, '%d/%m %Hh%M')"/>
                </div>
              </div>
              <div style="font-family:'Source Serif 4',serif; font-size:17px; font-weight:700; white-space:nowrap;"><t t-esc="'%g' % g.duration_hours"/> h</div>
            </div>
            <div t-if="g.flag_reason" style="font-size:12px; color:var(--warn);" t-esc="g.flag_reason"/>
            <div style="display:flex; gap:8px; align-items:center;">
              <label style="font-size:12px; color:var(--muted);">Évaluation (facultative)</label>
              <select name="rating" class="btn-sm">
                <option value="">—</option>
                <option value="1">1</option><option value="2">2</option><option value="3">3</option>
                <option value="4">4</option><option value="5">5</option>
              </select>
            </div>
            <textarea name="comment" rows="2" placeholder="Commentaire (facultatif)" class="ap-input" style="height:auto; padding:10px 12px;"/>
            <button type="button" class="sv-validate btn-primary">Valider avec mon empreinte</button>
            <p class="sv-msg ac-result" style="display:none;"/>
          </div>
        </t>
        <a href="/odoo" style="text-align:center; font-size:13px; color:var(--muted); padding:6px;">Retour à l'espace enseignant</a>
      </div>

      <t t-set="head">
        <style>
          .ap-input { width:100%; box-sizing:border-box; border-radius:10px; border:1px solid var(--line); background:var(--surface); color:var(--ink); padding:10px 12px; font-family:inherit; font-size:14px; }
        </style>
      </t>
      <t t-set="scripts">
        <script type="text/javascript">
          document.addEventListener('DOMContentLoaded', function () {
            var SA = window.SchoolAttendance, P = window.SchoolPwa;
            function show(el, cls, text) { el.className = 'sv-msg ac-result ' + cls; el.textContent = text; el.style.display = 'block'; }
            document.querySelectorAll('.sv-row').forEach(function (row) {
              var btn = row.querySelector('.sv-validate'), msg = row.querySelector('.sv-msg');
              btn.addEventListener('click', function () {
                var data = { attendance_id: row.dataset.id, rating: row.querySelector('[name=rating]').value || null,
                             comment: row.querySelector('[name=comment]').value || null };
                btn.disabled = true; show(msg, '', 'Vérification…');
                P.probe().then(function (state) {
                  if (state === 'offline') {
                    return P.confirmOffline(Object.assign({ target: 'internship_validation' }, data), { gps: false })
                      .then(function () { show(msg, 'ac-warn', 'Validation enregistrée hors ligne.'); });
                  }
                  return SA.runWebAuthnCeremony('/presence/stages/superviseur/options').then(function (wa) {
                    return SA.rpcCall('/presence/stages/valider', Object.assign(data, { webauthn_mode: wa.mode, webauthn_credential: wa.credential }));
                  }).then(function (res) {
                    res = res || {};
                    if (res.error) { btn.disabled = false; show(msg, 'ac-err', res.error); return; }
                    show(msg, 'ac-ok', 'Garde validée.'); btn.style.display = 'none';
                  });
                }).catch(function (err) { btn.disabled = false; show(msg, 'ac-err', err.message || String(err)); });
              });
            });
          });
        </script>
      </t>
    </t>
  </template>

  <template id="portal_supervisor_denied" name="Portail — Superviseur non reconnu">
    <t t-call="school_attendance_qr.portal_shell">
      <t t-set="page_title">Gardes à valider</t>

      <header class="topbar">
        <h1>Gardes à valider</h1>
      </header>
      <div class="page">
        <div class="card" style="text-align:center; color:var(--muted); padding:28px;">
          Cet écran est réservé aux superviseurs désignés d'un site de stage.
        </div>
      </div>
    </t>
  </template>

</odoo>
