<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Un superviseur ne voit que SES sites, leurs périodes, gardes et évaluations
       (lecture seule : la validation passe par l'écran dédié, avec son empreinte) -->
  <record id="rule_site_supervisor" model="ir.rule">
    <field name="name">Sites de stage : superviseur, les siens</field>
    <field name="model_id" ref="model_school_internship_site"/>
    <field name="groups" eval="[(4, ref('group_internship_supervisor'))]"/>
    <field name="domain_force">[('supervisor_ids.user_id', '=', user.id)]</field>
  </record>
  <record id="rule_site_admin" model="ir.rule">
    <field name="name">Sites de stage : administration, tous</field>
    <field name="model_id" ref="model_school_internship_site"/>
    <field name="groups" eval="[(4, ref('school_base.group_school_admin'))]"/>
    <field name="domain_force">[(1, '=', 1)]</field>
  </record>

  <record id="rule_period_supervisor" model="ir.rule">
    <field name="name">Périodes de stage : superviseur, ses sites</field>
    <field name="model_id" ref="model_school_internship_period"/>
    <field name="groups" eval="[(4, ref('group_internship_supervisor'))]"/>
    <field name="domain_force">[('site_id.supervisor_ids.user_id', '=', user.id)]</field>
  </record>
  <record id="rule_period_admin" model="ir.rule">
    <field name="name">Périodes de stage : administration, toutes</field>
    <field name="model_id" ref="model_school_internship_period"/>
    <field name="groups" eval="[(4, ref('school_base.group_school_admin'))]"/>
    <field name="domain_force">[(1, '=', 1)]</field>
  </record>

  <record id="rule_shift_supervisor" model="ir.rule">
    <field name="name">Gardes : superviseur, ses sites</field>
    <field name="model_id" ref="model_school_internship_attendance"/>
    <field name="groups" eval="[(4, ref('group_internship_supervisor'))]"/>
    <field name="domain_force">[('site_id.supervisor_ids.user_id', '=', user.id)]</field>
  </record>
  <record id="rule_shift_admin" model="ir.rule">
    <field name="name">Gardes : administration, toutes</field>
    <field name="model_id" ref="model_school_internship_attendance"/>
    <field name="groups" eval="[(4, ref('school_base.group_school_admin'))]"/>
    <field name="domain_force">[(1, '=', 1)]</field>
  </record>

  <record id="rule_evaluation_supervisor" model="ir.rule">
    <field name="name">Évaluations de garde : superviseur, ses sites</field>
    <field name="model_id" ref="model_school_internship_evaluation"/>
    <field name="groups" eval="[(4, ref('group_internship_supervisor'))]"/>
    <field name="domain_force">[('site_id.supervisor_ids.user_id', '=', user.id)]</field>
  </record>
  <record id="rule_evaluation_admin" model="ir.rule">
    <field name="name">Évaluations de garde : administration, toutes</field>
    <field name="model_id" ref="model_school_internship_evaluation"/>
    <field name="groups" eval="[(4, ref('school_base.group_school_admin'))]"/>
    <field name="domain_force">[(1, '=', 1)]</field>
  </record>
</odoo>
