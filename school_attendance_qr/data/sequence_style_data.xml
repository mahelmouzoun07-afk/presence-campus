<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <record id="seq_attendance_certificate" model="ir.sequence">
    <field name="name">Attestation de présence</field>
    <field name="code">school.attendance.certificate</field>
    <field name="prefix">ATT/%(year)s/</field>
    <field name="padding">4</field>
    <field name="company_id" eval="False"/>
  </record>

  <record id="qr_style_default" model="school.qr.style">
    <field name="name">Bleu nuit et bronze (par défaut)</field>
    <field name="sequence">10</field>
    <field name="shape">rounded</field>
    <field name="color_mode">radial</field>
    <field name="color_1">#14213D</field>
    <field name="color_2">#8C5A0B</field>
    <field name="background_color">#FFFFFF</field>
  </record>
</odoo>
