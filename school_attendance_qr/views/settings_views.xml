<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_config_settings_view_form_school" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.school</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="85"/>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app data-string="École" string="École" name="school_attendance_qr" groups="school_base.group_school_admin">
          <block title="Établissement">
            <setting string="Logo de l'établissement" help="Affiché au centre des QR codes, sur les affiches et les attestations.">
              <field name="school_logo" widget="image" class="oe_avatar"/>
            </setting>
            <setting string="Fuseau horaire" help="Sert à convertir les heures de l'emploi du temps (ex. Africa/Porto-Novo).">
              <field name="school_timezone"/>
            </setting>
            <setting string="Réseaux autorisés" help="Adresses IP ou plages (séparées par des virgules) du Wi-Fi de l'école. Laissez vide pour ne rien restreindre.">
              <field name="school_campus_ip_ranges" placeholder="41.138.1.0/24"/>
            </setting>
          </block>
          <block title="Alertes d'absences">
            <setting string="Seuil d'alerte" help="Un étudiant passe dans « À traiter » quand son taux de présence tombe sous ce seuil.">
              <div class="content-group">
                <div class="row mt8"><label class="col-lg-6" string="Taux minimum (%)" for="school_alert_rate"/><field name="school_alert_rate"/></div>
                <div class="row"><label class="col-lg-6" string="À partir de (séances)" for="school_alert_min_sessions"/><field name="school_alert_min_sessions"/></div>
              </div>
            </setting>
            <setting string="E-mail à l'étudiant" help="Nécessite un serveur de messagerie sortant, donc de l'Internet (inutile sur un réseau fermé).">
              <field name="school_alert_send_email"/>
            </setting>
          </block>
          <block title="Sécurité">
            <setting string="Double authentification (personnel)"
                     help="Le personnel devra saisir, en plus du mot de passe, un code de l'application Google Authenticator (ou un code reçu par e-mail s'il ne l'a pas activée). Configurez d'abord l'envoi d'e-mails.">
              <field name="school_require_2fa"/>
            </setting>
            <setting string="Comptes signalés" help="Après ce nombre d'échecs de connexion d'affilée, l'étudiant est signalé à la direction dans « À traiter ».">
              <field name="school_login_alert_attempts"/>
            </setting>
            <setting string="Détection des fraudes" help="Seuils des contrôles automatiques après chaque confirmation.">
              <div class="content-group">
                <div class="row mt8"><label class="col-lg-7" string="Confirmations groupées : fenêtre (s)" for="school_cluster_seconds"/><field name="school_cluster_seconds"/></div>
                <div class="row"><label class="col-lg-7" string="Confirmations groupées : à partir de" for="school_cluster_min"/><field name="school_cluster_min"/></div>
                <div class="row"><label class="col-lg-7" string="Vitesse maximale crédible (km/h)" for="school_max_speed_kmh"/><field name="school_max_speed_kmh"/></div>
              </div>
            </setting>
          </block>
          <block title="Étudiants sans téléphone (présence relayée)">
            <setting string="Responsable du relais" help="Qui confirme, avec sa propre empreinte, la présence d'un étudiant marqué « sans téléphone utilisable ».">
              <field name="school_relay_actor"/>
            </setting>
            <setting string="Garde-fous" help="Quota par séance, contrôles tirés au sort et détection des relais répétés.">
              <div class="content-group">
                <div class="row mt8"><label class="col-lg-7" string="Relais maximum par séance" for="school_relay_max_per_session"/><field name="school_relay_max_per_session"/></div>
                <div class="row"><label class="col-lg-7" string="Contrôles aléatoires (%)" for="school_relay_audit_rate"/><field name="school_relay_audit_rate"/></div>
                <div class="row"><label class="col-lg-7" string="Relais répétés : seuil sur 30 jours" for="school_relay_pattern_threshold"/><field name="school_relay_pattern_threshold"/></div>
              </div>
            </setting>
          </block>
          <block title="Scolarité et présence">
            <setting string="Étudiants avec scolarité impayée"
                     help="Par défaut, rien ne change. « Signaler » enregistre la présence mais la place dans « À traiter ». « Bloquer » refuse la confirmation de présence : à réserver à une politique claire et connue des étudiants.">
              <field name="school_payment_policy"/>
            </setting>
            <setting string="Paiements partiels" help="Appliquer aussi la règle ci-dessus aux étudiants qui ont payé une partie seulement.">
              <field name="school_payment_include_partial"/>
            </setting>
          </block>
        </app>
      </xpath>
    </field>
  </record>
</odoo>
