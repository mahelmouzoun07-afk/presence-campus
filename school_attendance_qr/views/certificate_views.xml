<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_certificate_list" model="ir.ui.view">
    <field name="name">school.attendance.certificate.list</field>
    <field name="model">school.attendance.certificate</field>
    <field name="arch" type="xml">
      <list create="0">
        <field name="name"/><field name="student_id"/><field name="date_from"/><field name="date_to"/>
        <field name="attended"/><field name="expected"/><field name="rate"/>
        <field name="issue_date"/><field name="issued_by"/>
      </list>
    </field>
  </record>

  <record id="view_certificate_form" model="ir.ui.view">
    <field name="name">school.attendance.certificate.form</field>
    <field name="model">school.attendance.certificate</field>
    <field name="arch" type="xml">
      <form create="0" edit="0">
        <header>
          <button name="action_download" type="object" string="Télécharger le PDF" class="btn-primary"/>
        </header>
        <sheet>
          <group>
            <group><field name="name"/><field name="student_id"/><field name="date_from"/><field name="date_to"/></group>
            <group><field name="attended"/><field name="expected"/><field name="rate"/>
              <field name="issue_date"/><field name="issued_by"/></group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_certificate_search" model="ir.ui.view">
    <field name="name">school.attendance.certificate.search</field>
    <field name="model">school.attendance.certificate</field>
    <field name="arch" type="xml">
      <search><field name="name"/><field name="student_id"/></search>
    </field>
  </record>

  <record id="action_certificate" model="ir.actions.act_window">
    <field name="name">Attestations de présence</field>
    <field name="res_model">school.attendance.certificate</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_certificate_search"/>
  </record>

  <!-- Assistant : choisir la période puis télécharger le PDF -->
  <record id="view_certificate_wizard_form" model="ir.ui.view">
    <field name="name">school.certificate.wizard.form</field>
    <field name="model">school.certificate.wizard</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <field name="student_id"/><field name="date_from"/><field name="date_to"/>
        </group>
        <footer>
          <button name="action_generate" type="object" string="Générer l'attestation (PDF)" class="btn-primary"/>
          <button string="Annuler" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="action_certificate_wizard" model="ir.actions.act_window">
    <field name="name">Attestation de présence</field>
    <field name="res_model">school.certificate.wizard</field>
    <field name="view_mode">form</field><field name="target">new</field>
  </record>

  <!-- Bouton sur la fiche étudiant -->
  <record id="view_school_student_form_certificate" model="ir.ui.view">
    <field name="name">school.student.form.certificate</field>
    <field name="model">school.student</field>
    <field name="inherit_id" ref="school_base.view_school_student_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="%(action_certificate_wizard)d" type="action" string="Attestation de présence"
                groups="school_base.group_school_admin" invisible="not id"
                context="{'default_student_id': id}"/>
      </xpath>
    </field>
  </record>

  <menuitem id="menu_certificate" name="Attestations" parent="school_base.menu_school_root"
            action="action_certificate" sequence="55" groups="school_base.group_school_admin"/>
</odoo>
