<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Page ouverte en scannant le QR permanent de la salle.
       Mêmes composants que l'accueil (ac_seal, ac_result), avec en plus
       une liste d'étapes rassurantes. -->
  <template id="scan_page_template" name="Scan de présence">
    <t t-call="school_attendance_qr.portal_shell">
      <t t-set="page_title">Confirmer ma présence</t>

      <header class="topbar">
        <div class="topbar-row">
          <a href="/presence" class="icon-btn" aria-label="Retour">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
          </a>
          <h1 style="font-size:20px; margin:0;">Confirmer ma présence</h1>
          <span style="width:40px;"/>
        </div>
      </header>

      <div class="page plain">
        <t t-if="not room">
          <div class="card" style="text-align:center; color:var(--bad); padding:30px;">
            Ce code QR n'est pas reconnu. Signalez-le au secrétariat.
          </div>
        </t>
        <t t-elif="not session">
          <div class="card" style="text-align:center;">
            <div class="eyebrow muted">AUCUN COURS EN COURS</div>
            <div class="h-title" style="margin-top:6px;" t-esc="room.name"/>
            <div class="h-sub">Revenez à l'heure de votre cours pour confirmer votre présence.</div>
          </div>
        </t>
        <t t-else="">
          <div style="text-align:center; margin-bottom:6px;">
            <div class="eyebrow">
              <t t-esc="'SORTIE À CONFIRMER' if phase_hint == 'checkout' else 'ENTRÉE OUVERTE'"/>
            </div>
            <div class="h-title" style="font-size:24px; margin-top:4px;" t-esc="session.course_id.name"/>
            <div class="h-sub">
              <t t-esc="room.name"/> ·
              <t t-esc="request.env['school.attendance.session'].fmt_local(session.time_start, '%Hh%M')"/>
              – <t t-esc="request.env['school.attendance.session'].fmt_local(session.time_end, '%Hh%M')"/>
            </div>
          </div>

          <button type="button" id="ac_seal" class="ac-seal">
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 11c0 3-1 6-3 8"/><path d="M8 7.5A5 5 0 0 1 17 11c0 2 0 4-1 6"/><path d="M5 10a7 7 0 0 1 2-4.5"/><path d="M19.5 9a8 8 0 0 0-3-4.2"/><path d="M12 11v1"/></svg>
            <span class="ac-seal-label" t-esc="'Confirmer ma sortie' if phase_hint == 'checkout' else 'Confirmer mon entrée'"/>
          </button>
          <p id="ac_result" class="ac-result" style="display:none;"/>
          <p id="ac_result_sub" class="ac-result-sub" style="display:none;"/>

          <ol class="card" style="list-style:none; margin:16px 0 0; padding:16px; display:flex; flex-direction:column; gap:12px;">
            <li style="display:flex; align-items:center; gap:12px;">
              <span class="step-pill muted">1</span>
              <div><div class="step-title">Position GPS</div><div class="step-sub">Vérifiée depuis votre téléphone</div></div>
            </li>
            <li style="display:flex; align-items:center; gap:12px;">
              <span class="step-pill muted">2</span>
              <div><div class="step-title">Wi-Fi de l'école</div><div class="step-sub">Vous devez y être connecté(e)</div></div>
            </li>
            <li style="display:flex; align-items:center; gap:12px;">
              <span class="step-pill muted">3</span>
              <div><div class="step-title">Empreinte</div><div class="step-sub">Déverrouillage du téléphone</div></div>
            </li>
            <li style="display:flex; align-items:center; gap:12px;">
              <span class="step-pill muted">4</span>
              <div><div class="step-title">Enregistrement</div><div class="step-sub">Dans le système de l'école</div></div>
            </li>
          </ol>
          <p style="font-size:12px; color:var(--muted); text-align:center; margin:14px 20px 0;">
            Votre empreinte reste sur votre téléphone : seule une preuve chiffrée est envoyée.
          </p>

          <script type="text/javascript">
            document.addEventListener('DOMContentLoaded', function () {
              SchoolAttendance.initConfirmWidget('<t t-esc="token"/>', '<t t-esc="phase_hint"/>', {
                zones: [{ lat: <t t-esc="room.latitude"/>, lng: <t t-esc="room.longitude"/>, radius: <t t-esc="room.radius_meters"/> }],
              });
            });
          </script>
        </t>
      </div>

      <t t-set="head">
        <style>
          .step-pill {
            width:26px; height:26px; border-radius:13px; flex:none;
            display:flex; align-items:center; justify-content:center;
            font-size:12px; font-weight:700;
            background:var(--line-soft); color:var(--muted);
          }
          .step-pill.ok { background:var(--ok-soft); color:var(--ok); }
          .step-pill.busy { background:var(--accent-soft); color:var(--accent); }
          .step-title { font-size:14px; font-weight:600; }
          .step-sub { font-size:12px; color:var(--muted); }
        </style>
      </t>
    </t>
  </template>

</odoo>
