<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="scan_page_template" name="Confirmer sa présence">
    <t t-call="portal.frontend_layout">
      <t t-set="head">
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@600;700&amp;family=IBM+Plex+Sans:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
        <style>
          :root{
            --ink:#14213D; --mist:#EFF1F2; --paper:#FFFFFF;
            --gold:#C68A2E; --green:#2F6B4F; --brick:#A23E2D; --amber:#B8862E;
            --muted:#5B6472; --line:#D8D9D2;
          }
          .ac-wrap{
            background:var(--mist); min-height:70vh; margin:-1.5rem -0.75rem; padding:3.5rem 1.25rem 3rem;
            font-family:'IBM Plex Sans', sans-serif; color:var(--ink);
            display:flex; justify-content:center;
          }
          .ac-card{ width:100%; max-width:420px; text-align:center; }
          .ac-course{
            font-family:'Source Serif 4', serif; font-weight:700; font-size:1.9rem;
            line-height:1.2; margin:0 0 0.4rem;
          }
          .ac-meta{ color:var(--muted); font-size:0.95rem; margin:0 0 2.5rem; }
          .ac-meta span{ display:block; }

          .ac-seal{
            width:168px; height:168px; border-radius:50%; margin:0 auto 1.75rem;
            border:3px solid var(--ink); background:var(--paper);
            display:flex; align-items:center; justify-content:center;
            cursor:pointer; user-select:none; transition:transform .15s ease;
          }
          .ac-seal:active{ transform:scale(0.96); }
          .ac-seal.ac-busy{ opacity:.6; pointer-events:none; }
          .ac-seal-label{ font-size:1rem; font-weight:600; }

          .ac-seal.ac-stamped{
            animation:ac-stamp .32s ease-out;
            border-color:var(--state-color, var(--green));
            color:var(--state-color, var(--green));
          }
          @keyframes ac-stamp{
            0%{ transform:scale(1.5) rotate(-10deg); opacity:0; }
            60%{ transform:scale(0.95) rotate(2deg); opacity:1; }
            100%{ transform:scale(1) rotate(0); }
          }
          .ac-icon{ width:56px; height:56px; }

          .ac-result{ font-size:1.05rem; font-weight:500; margin:0 0 0.35rem; }
          .ac-result-sub{ color:var(--muted); font-size:0.9rem; margin:0; }
          .ac-result.ac-ok{ color:var(--green); }
          .ac-result.ac-warn{ color:var(--amber); }
          .ac-result.ac-err{ color:var(--brick); }

          .ac-empty{
            border:1px solid var(--line); border-radius:4px; padding:2rem 1.5rem;
            background:var(--paper);
          }
          .ac-empty p{ margin:0; color:var(--muted); }
          .ac-empty .ac-empty-title{ color:var(--ink); font-weight:600; margin-bottom:0.4rem; }

          .ac-foot{ color:var(--muted); font-size:0.8rem; margin-top:2rem; line-height:1.5; }
        </style>
      </t>

      <div class="ac-wrap">
        <div class="ac-card">

          <t t-if="not room">
            <div class="ac-empty">
              <p class="ac-empty-title">Code non reconnu</p>
              <p>Ce QR ne correspond à aucune salle enregistrée. Vérifie que tu as bien scanné le code affiché dans la salle.</p>
            </div>
          </t>

          <t t-elif="not session">
            <h1 class="ac-course" t-esc="room.name"/>
            <p class="ac-meta"><span t-esc="room.building or ''"/></p>
            <div class="ac-empty">
              <p class="ac-empty-title">Pas de cours en ce moment</p>
              <p>Aucune séance n'accepte de confirmation de présence dans cette salle actuellement. Scanne à nouveau une fois le cours commencé.</p>
            </div>
          </t>

          <t t-else="">
            <h1 class="ac-course" t-esc="session.course_id.name"/>
            <p class="ac-meta">
              <span t-esc="room.name"/>
              <span t-esc="session.date"/>
            </p>

            <p class="ac-meta" style="margin-bottom:1rem;">
              <span t-if="phase_hint == 'checkout'">Scan de fin de cours</span>
              <span t-else="">Scan de début de cours</span>
            </p>
            <div id="ac_seal" class="ac-seal">
              <span class="ac-seal-label" t-esc="'Confirmer ma sortie' if phase_hint == 'checkout' else 'Confirmer mon entrée'"/>
            </div>

            <p id="ac_result" class="ac-result" style="display:none;"/>
            <p id="ac_result_sub" class="ac-result-sub" style="display:none;"/>

            <p class="ac-foot">
              Ta position et ton appareil sont vérifiés automatiquement pour confirmer que tu es bien en classe.
            </p>
          </t>

        </div>
      </div>

      <t t-if="session">
        <script type="text/javascript" src="/school_attendance_qr/static/src/js/confirm.js"></script>
        <script type="text/javascript">
          document.addEventListener('DOMContentLoaded', function () {
            SchoolAttendance.initConfirmWidget('<t t-esc="token"/>', '<t t-esc="phase_hint"/>');
          });
        </script>
      </t>
    </t>
  </template>

  <record id="action_attendance_record" model="ir.actions.act_window">
    <field name="name">Présences (QR)</field>
    <field name="res_model">school.attendance.record</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_attendance_qr" name="Présences" parent="school_base.menu_school_root" action="action_attendance_record" sequence="50" groups="school_base.group_school_teacher"/>

</odoo>
