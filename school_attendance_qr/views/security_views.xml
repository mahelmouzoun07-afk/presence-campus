<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Journal d'audit : lecture seule, pour la direction et l'administration -->
  <record id="view_audit_log_list" model="ir.ui.view">
    <field name="name">school.audit.log.list</field>
    <field name="model">school.audit.log</field>
    <field name="arch" type="xml">
      <list create="0" edit="0" delete="0" decoration-danger="event_type in ('fraud', 'login_failures')">
        <header>
          <button name="action_check_integrity" type="object" string="Vérifier l'intégrité du journal"
                  display="always"/>
        </header>
        <field name="logged_at"/>
        <field name="event_type"/>
        <field name="student_label"/>
        <field name="description"/>
        <field name="user_id"/>
        <field name="ip_address" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="view_audit_log_form" model="ir.ui.view">
    <field name="name">school.audit.log.form</field>
    <field name="model">school.audit.log</field>
    <field name="arch" type="xml">
      <form create="0" edit="0" delete="0">
        <sheet>
          <group>
            <group>
              <field name="logged_at"/><field name="event_type"/><field name="user_id"/><field name="ip_address"/>
            </group>
            <group>
              <field name="student_id"/><field name="student_label"/><field name="res_model"/><field name="res_id"/>
            </group>
          </group>
          <field name="description" nolabel="1"/>
          <group string="Chaînage (preuve d'intégrité)">
            <field name="previous_hash"/><field name="log_hash"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_audit_log_search" model="ir.ui.view">
    <field name="name">school.audit.log.search</field>
    <field name="model">school.audit.log</field>
    <field name="arch" type="xml">
      <search>
        <field name="student_label" string="Étudiant"/>
        <field name="description"/>
        <field name="user_id"/>
        <filter string="Anomalies de sécurité" name="fraud" domain="[('event_type', 'in', ('fraud', 'login_failures'))]"/>
        <filter string="Présences" name="presence"
                domain="[('event_type', 'in', ('presence', 'presence_refused', 'presence_relayed', 'presence_offline'))]"/>
        <group expand="0" string="Regrouper par">
          <filter string="Événement" name="group_event" context="{'group_by': 'event_type'}"/>
          <filter string="Jour" name="group_day" context="{'group_by': 'logged_at:day'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_audit_log" model="ir.actions.act_window">
    <field name="name">Journal d'audit</field>
    <field name="res_model">school.audit.log</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p>Chaque action sensible (présence, relais, réinitialisation, anomalie...) laisse ici une trace
        que personne ne peut modifier ni supprimer.</p>
    </field>
  </record>

  <menuitem id="menu_audit_log" name="Journal d'audit" parent="menu_school_config" action="action_audit_log"
            sequence="30" groups="school_base.group_school_admin"/>

  <!-- Fiche étudiant : état du compte -->
  <record id="view_school_student_form_security" model="ir.ui.view">
    <field name="name">school.student.form.security</field>
    <field name="model">school.student</field>
    <field name="inherit_id" ref="school_base.view_school_student_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="before">
        <div class="alert alert-danger mb-0" role="alert" invisible="not account_flagged">
          Compte signalé : trop de tentatives de connexion échouées d'affilée. Vérifiez auprès de l'étudiant,
          puis réinitialisez son mot de passe si besoin.
        </div>
      </xpath>
      <xpath expr="//field[@name='last_login_ip']" position="after">
        <field name="must_change_password"/>
        <field name="failed_logins"/>
        <field name="account_flagged"/>
      </xpath>
    </field>
  </record>

</odoo>
