<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Planning : sélecteur de jours en haut, liste des cours du jour choisi en dessous.
       Le jour en cours est pré-sélectionné (via location.hash #DD-MM côté client). -->
  <template id="portal_timetable" name="Planning">
    <t t-call="school_attendance_qr.portal_shell">
      <t t-set="page_title">Planning</t>
      <t t-set="active_nav">timetable</t>

      <header class="topbar">
        <h1>Planning</h1>
        <div class="week-strip" role="tablist">
          <t t-foreach="week" t-as="d">
            <button type="button" class="day-tile" role="tab"
                    t-att-data-day="d['key']" t-att-aria-selected="'true' if d['today'] else 'false'">
              <span class="day-label" t-esc="d['label']"/>
              <span class="day-num" t-esc="d['num']"/>
              <t t-if="d['has']"><span class="day-dot"/></t>
            </button>
          </t>
        </div>
      </header>

      <div class="page">
        <t t-foreach="week" t-as="d">
          <section class="day-pane" t-att-data-day="d['key']" t-att-hidden="'' if not d['today'] else None">
            <div class="section-label"><t t-esc="d['title']"/></div>
            <t t-if="not d['items']">
              <div class="card" style="text-align:center; padding:26px; color:var(--muted);">Pas de cours ce jour-là.</div>
            </t>
            <t t-foreach="d['items']" t-as="c">
              <div class="card session-row">
                <div class="session-time">
                  <div class="session-start" t-esc="c['start']"/>
                  <div class="session-end" t-esc="c['end']"/>
                </div>
                <span class="session-rail" t-att-style="'background:' + c['color']"/>
                <div class="session-main">
                  <div class="session-name" t-esc="c['name']"/>
                  <div class="session-place" t-esc="c['place']"/>
                </div>
                <span class="badge" t-att-style="'color:' + c['color'] + ';background:transparent;border-color:' + c['color']">
                  <t t-esc="c['status']"/>
                </span>
              </div>
            </t>
          </section>
        </t>
      </div>

      <t t-set="head">
        <style>
          .week-strip { display:grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap:6px; }
          .day-tile {
            background: rgba(255,255,255,.1); color: #C4CAD8; border: none; border-radius: 14px;
            height: 58px; display:flex; flex-direction:column; align-items:center; justify-content:center;
            gap: 2px; cursor:pointer; font-family:inherit;
          }
          .day-tile[aria-selected="true"] { background:#fff; color:var(--ink); }
          .day-label { font-size: 11px; }
          .day-num { font-size: 17px; font-weight: 700; }
          .day-dot { width:5px; height:5px; border-radius:3px; background:var(--accent); margin-top:2px; }
          .day-tile[aria-selected="true"] .day-dot { background:var(--accent); }
          .session-row { display:flex; gap:12px; align-items:stretch; }
          .session-time { width:52px; flex:none; font-variant-numeric: tabular-nums; }
          .session-start { font-size:14px; font-weight:700; }
          .session-end { font-size:12px; color:var(--muted); }
          .session-rail { width:4px; border-radius:2px; }
          .session-main { flex:1; min-width:0; }
          .session-name { font-size:14.5px; font-weight:600; }
          .session-place { font-size:12.5px; color:var(--muted); }
        </style>
      </t>
      <t t-set="scripts">
        <script type="text/javascript">
          document.addEventListener('DOMContentLoaded', function () {
            var tiles = document.querySelectorAll('.day-tile');
            var panes = document.querySelectorAll('.day-pane');
            function pick(key) {
              tiles.forEach(function (t) { t.setAttribute('aria-selected', t.dataset.day === key ? 'true' : 'false'); });
              panes.forEach(function (p) { p.hidden = p.dataset.day !== key; });
              try { history.replaceState(null, '', '#' + key); } catch (e) {}
            }
            tiles.forEach(function (t) { t.addEventListener('click', function () { pick(t.dataset.day); }); });
            if (location.hash) { var k = location.hash.slice(1); if (document.querySelector('.day-pane[data-day="' + k + '"]')) pick(k); }
          });
        </script>
      </t>
    </t>
  </template>

</odoo>
