<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_qr_style_list" model="ir.ui.view">
    <field name="name">school.qr.style.list</field>
    <field name="model">school.qr.style</field>
    <field name="arch" type="xml">
      <list><field name="sequence" widget="handle"/><field name="name"/><field name="shape"/><field name="color_mode"/>
        <field name="color_1" widget="color"/><field name="color_2" widget="color"/></list>
    </field>
  </record>

  <record id="view_qr_style_form" model="ir.ui.view">
    <field name="name">school.qr.style.form</field>
    <field name="model">school.qr.style</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group string="Apparence">
              <field name="name"/>
              <field name="shape"/>
              <field name="color_mode"/>
              <field name="color_1" widget="color"/>
              <field name="color_2" widget="color" invisible="color_mode == 'solid'"/>
              <field name="background_color" widget="color"/>
            </group>
            <group string="Aperçu en direct">
              <field name="preview_image" widget="image" nolabel="1" options="{'size': [260, 260]}" readonly="1"/>
            </group>
          </group>
          <group>
            <group string="Logo au centre">
              <field name="logo" widget="image" options="{'size': [120, 120]}"/>
              <field name="use_school_logo"/>
              <field name="logo_scale"/>
            </group>
            <group string="Affiche imprimable">
              <field name="poster_title"/>
              <field name="poster_subtitle"/>
              <field name="sequence"/>
            </group>
          </group>
          <p class="text-muted">
            L'aperçu se met à jour après enregistrement. Le contraste avec le fond est vérifié automatiquement :
            un QR trop pâle serait illisible par les téléphones. Le premier style de la liste est celui par défaut ;
            une salle peut en choisir un autre.
          </p>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_qr_style" model="ir.actions.act_window">
    <field name="name">Styles de QR</field><field name="res_model">school.qr.style</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="action_school_settings" model="ir.actions.act_window">
    <field name="name">Réglages</field><field name="res_model">res.config.settings</field>
    <field name="view_mode">form</field><field name="target">inline</field>
    <field name="context">{'module': 'school_attendance_qr', 'bin_size': False}</field>
  </record>

  <menuitem id="menu_school_config" name="Configuration" parent="school_base.menu_school_root" sequence="90"
            groups="school_base.group_school_admin"/>
  <menuitem id="menu_qr_style" name="Styles de QR" parent="menu_school_config" action="action_qr_style" sequence="10"/>
  <menuitem id="menu_school_settings" name="Réglages" parent="menu_school_config" action="action_school_settings" sequence="20"/>
</odoo>
