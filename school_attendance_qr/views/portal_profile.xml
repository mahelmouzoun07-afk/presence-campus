<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Profil (« Moi ») : carte verte (identité + visage), chiffres clés, raccourcis, préférences, déconnexion.
       Les absences sont une sous-page du profil. -->
  <template id="portal_profile" name="Profil étudiant">
    <t t-call="school_attendance_qr.portal_shell">
      <t t-set="page_title">Profil</t>
      <t t-set="active_nav">profile</t>

      <div class="page plain" style="margin-top:0; padding-top:44px;">

        <div style="display:flex; align-items:center; justify-content:space-between; padding:0 2px;">
          <a href="/presence" class="icon-btn dark" aria-label="Retour à l'accueil" style="box-shadow:var(--card-shadow);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
          </a>
          <h1 style="font-size:20px; margin:0;">Profil</h1>
          <span style="width:46px;"/>
        </div>

        <!-- identité -->
        <section style="position:relative; overflow:hidden; border-radius:34px; padding:22px; background:var(--brand); display:flex; align-items:center; gap:16px;">
          <div style="position:absolute; right:-60px; top:-70px; width:140px; height:140px; border-radius:50%; background:var(--blob-1); opacity:.9;"></div>
          <div style="position:relative; flex:none; width:76px; height:76px; border-radius:50%; background:#fff; padding:4px;">
            <div style="width:100%; height:100%; border-radius:50%; background:#2B7A3B; color:#fff; display:flex; align-items:center; justify-content:center; font-size:26px; font-weight:800;">
              <t t-esc="((student.prenom or ' ')[0] + (student.nom or ' ')[0]).upper()"/>
            </div>
          </div>
          <div style="position:relative; min-width:0;">
            <div style="font-size:25px; font-weight:800; letter-spacing:-0.02em; line-height:1.1; color:#fff;" t-esc="student.name"/>
            <div style="margin-top:4px; font-size:14px; font-weight:700; color:var(--on-brand);">Matricule <t t-esc="student.matricule"/></div>
            <div t-if="student.promotion_id or student.filiere_id" style="font-size:13px; font-weight:700; color:var(--on-brand);">
              <t t-if="student.promotion_id" t-esc="student.promotion_id.name"/><t t-if="student.promotion_id and student.filiere_id"> · </t><t t-if="student.filiere_id" t-esc="student.filiere_id.name"/>
            </div>
            <div t-if="student.face_enrolled_at" style="margin-top:10px; display:inline-flex; align-items:center; gap:6px; height:30px; padding:0 12px; border-radius:15px; background:#fff; color:#1B1B22; font-size:13px; font-weight:800;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2B7A3B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
              Visage inscrit
            </div>
            <div t-else="" style="margin-top:10px; display:inline-flex; align-items:center; gap:6px; height:30px; padding:0 12px; border-radius:15px; background:#fff; color:#1B1B22; font-size:13px; font-weight:800;">
              Visage à inscrire
            </div>
          </div>
        </section>

        <!-- 3 tuiles : présence, absences, moyenne -->
        <section class="card" style="display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); text-align:center; padding:18px 14px;">
          <t t-set="rate_color" t-value="'var(--ok)' if student.attendance_rate &gt;= 70 else 'var(--bad)'"/>
          <div>
            <div style="font-size:21px; font-weight:800;" t-att-style="'color:' + rate_color" t-esc="rate_label"/>
            <div style="font-size:12.5px; font-weight:600; color:var(--muted);">Présence</div>
          </div>
          <div style="border-left:1px solid var(--line-soft); border-right:1px solid var(--line-soft);">
            <div style="font-size:21px; font-weight:800;" t-esc="student.sessions_missed"/>
            <div style="font-size:12.5px; font-weight:600; color:var(--muted);">Absences</div>
          </div>
          <div>
            <t t-if="moyenne is not None">
              <div style="font-size:21px; font-weight:800;" t-esc="moyenne"/>
            </t>
            <t t-else="">
              <div style="font-size:21px; font-weight:800; color:var(--muted);">—</div>
            </t>
            <div style="font-size:12.5px; font-weight:600; color:var(--muted);">Moyenne</div>
          </div>
        </section>

        <!-- Raccourcis scolarité -->
        <section class="card-row">
          <a href="/presence/mes-absences" class="list-row">
            <span class="icon c-red"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4"/><path d="M8 15l2 2 4-4"/></svg></span>
            <div class="main"><div class="title">Mes absences</div></div>
            <span class="sub" style="font-size:14px; font-weight:600; color:var(--muted);"><t t-esc="student.sessions_missed"/> séance(s)</span>
            <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </a>
          <a href="/presence/attestations" class="list-row">
            <span class="icon c-yellow"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/></svg></span>
            <div class="main"><div class="title">Attestations de présence</div></div>
            <span class="sub" style="font-size:14px; font-weight:600; color:var(--muted);">PDF</span>
            <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </a>
          <t t-if="payment_status">
            <a href="/presence/profil" class="list-row">
              <span class="icon c-blue"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg></span>
              <div class="main"><div class="title">Scolarité</div></div>
              <span class="sub" style="font-size:14px; font-weight:800;" t-att-style="'color:' + payment_color" t-esc="payment_status"/>
            </a>
          </t>
        </section>

        <!-- Compte et préférences -->
        <section class="card-row">
          <div class="list-row">
            <span class="icon c-green"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2"/><path d="M9 9.5v1.2M15 9.5v1.2"/><path d="M9 14.2c1.4 1.3 4.6 1.3 6 0"/></svg></span>
            <div class="main"><div class="title">Visage</div></div>
            <t t-if="student.face_enrolled_at">
              <span style="font-size:14px; font-weight:800; color:var(--ok);">Inscrit</span>
            </t>
            <t t-else="">
              <span style="font-size:14px; font-weight:600; color:var(--muted);">À inscrire</span>
            </t>
          </div>
          <a href="/presence/mot-de-passe" class="list-row">
            <span class="icon c-green"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/></svg></span>
            <div class="main"><div class="title">Changer mon mot de passe</div></div>
            <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </a>
          <a href="/presence/notifications" class="list-row">
            <span class="icon c-blue"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 16V11a6 6 0 0 1 12 0v5l2 2H4l2-2z"/><path d="M10 21h4"/></svg></span>
            <div class="main"><div class="title">Notifications</div></div>
            <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </a>
          <div class="list-row">
            <span class="icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9c-4 0-9-4-9-9z"/></svg></span>
            <label class="main" for="theme-mode" style="cursor:pointer;"><div class="title">Thème</div></label>
            <select id="theme-mode" class="btn-sm">
              <option value="auto">Automatique</option>
              <option value="light">Clair</option>
              <option value="dark">Sombre</option>
            </select>
          </div>
        </section>

        <!-- installation de l'application -->
        <a href="/presence/installer" style="position:relative; overflow:hidden; display:block; border-radius:34px; padding:22px; min-height:150px; background:linear-gradient(160deg,#82AEF5 0%,#4A83E8 100%);">
          <div style="font-size:20px; font-weight:800; line-height:1.15; color:#0B1A33; max-width:190px;">Ajoute l'app à ton écran d'accueil</div>
          <span style="margin-top:14px; display:inline-flex; align-items:center; height:40px; padding:0 18px; border-radius:20px; background:#fff; color:#1B1B22; font-size:14px; font-weight:800;">Voir comment faire</span>
          <div aria-hidden="true" style="position:absolute; right:22px; bottom:-30px; width:116px; height:140px; border-radius:24px; background:#fff; color:#1B1B22; padding:14px;">
            <div style="font-size:11px; font-weight:600; color:#5C5C6B;">Prochain cours</div>
            <div style="margin-top:6px; font-size:18px; font-weight:800; line-height:1.1;">Présence<br/>École</div>
          </div>
        </a>

        <a href="/web/session/logout" class="list-row" style="background:var(--surface); border-radius:32px; padding:16px 20px; box-shadow:var(--card-shadow); border-bottom:0;">
          <span class="icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4"/><path d="M16 8l4 4-4 4M20 12H9"/></svg></span>
          <div class="main"><div class="title" style="color:var(--bad);">Se déconnecter</div></div>
        </a>

      </div>
      <t t-set="scripts">
        <script type="text/javascript">
          document.addEventListener('DOMContentLoaded', function () {
            var sel = document.getElementById('theme-mode');
            if (!sel) return;
            sel.value = (window.SchoolTheme &amp;&amp; window.SchoolTheme.get()) || 'auto';
            sel.addEventListener('change', function () { if (window.SchoolTheme) window.SchoolTheme.set(sel.value); });
          });
        </script>
      </t>
    </t>
  </template>

</odoo>
