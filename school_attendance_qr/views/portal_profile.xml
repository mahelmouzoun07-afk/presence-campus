<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="portal_profile" name="Portail — Mon profil">
    <t t-call="school_attendance_qr.portal_layout">
      <t t-set="active_nav">profile</t>

      <div class="pp-topbar" style="text-align:center; padding-bottom:40px;">
        <div style="width:68px; height:68px; border-radius:50%; background:var(--gold); margin:4px auto 12px; display:flex; align-items:center; justify-content:center; font-family:'Source Serif 4',serif; font-weight:700; font-size:24px;">
          <t t-esc="(student.prenom or ' ')[0]"/><t t-esc="(student.nom or ' ')[0]"/>
        </div>
        <div class="pp-h1" t-esc="student.name"/>
        <div style="color:#B9C0D4; font-size:13px; margin-top:3px;">
          Matricule <t t-esc="student.matricule"/><t t-if="student.promotion_id"> &#183; <t t-esc="student.promotion_id.name"/></t>
        </div>
      </div>

      <div style="padding:0 20px 24px; margin-top:-24px; display:flex; flex-direction:column; gap:14px;">

        <div class="pp-card" style="display:flex; justify-content:space-around; text-align:center;">
          <div>
            <div t-attf-style="font-size:18px; color:#{'var(--green)' if student.attendance_rate &gt;= 70 else 'var(--brick)'};"><span class="pp-h1" t-esc="rate_label"/></div>
            <div style="color:var(--muted); font-size:11.5px; margin-top:2px;">Présence</div>
          </div>
          <div style="width:1px; background:var(--line);"/>
          <div>
            <div class="pp-h1" style="font-size:18px;"><t t-esc="student.sessions_attended"/> / <t t-esc="student.sessions_expected"/></div>
            <div style="color:var(--muted); font-size:11.5px; margin-top:2px;">Séances</div>
          </div>
          <div style="width:1px; background:var(--line);"/>
          <div>
            <div class="pp-h1" style="font-size:18px;" t-esc="student.sessions_missed"/>
            <div style="color:var(--muted); font-size:11.5px; margin-top:2px;">Absences</div>
          </div>
        </div>

        <div>
          <div style="font-size:12px; font-weight:600; color:var(--muted); margin:4px 0 8px 4px;">SÉCURITÉ DU COMPTE</div>
          <div class="pp-card" style="padding:14px 16px; display:flex; align-items:center; gap:12px;">
            <div style="width:34px; height:34px; border-radius:9px; background:var(--mist); display:flex; align-items:center; justify-content:center; flex:none;">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" t-attf-stroke="#{'var(--green)' if student.webauthn_credential_id else 'var(--muted)'}" stroke-width="2"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg>
            </div>
            <div style="flex:1;">
              <div style="font-size:13.5px; font-weight:600;">Appareil enregistré</div>
              <t t-if="student.webauthn_credential_id">
                <div style="font-size:12px; color:var(--green); margin-top:1px;">Vérification par empreinte / code activée</div>
              </t>
              <t t-else="">
                <div style="font-size:12px; color:var(--muted); margin-top:1px;">Sera activée à votre première confirmation</div>
              </t>
            </div>
          </div>
        </div>

        <div>
          <div style="font-size:12px; font-weight:600; color:var(--muted); margin:4px 0 8px 4px;">ASSIDUITÉ</div>
          <div class="pp-card" style="padding:0; overflow:hidden;">
            <a href="/presence/mes-absences" style="display:flex; align-items:center; gap:12px; padding:14px 16px;">
              <div style="width:34px; height:34px; border-radius:9px; background:var(--mist); display:flex; align-items:center; justify-content:center; flex:none;">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/><path d="M9 16l2 2 4-4"/></svg>
              </div>
              <div style="flex:1; font-size:13.5px; font-weight:600;">Voir mes cours manqués</div>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
            </a>
          </div>
        </div>

      </div>
    </t>
  </template>
</odoo>
