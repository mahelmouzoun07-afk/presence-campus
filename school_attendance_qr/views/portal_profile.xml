<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Profil (« Moi ») : chiffres clés, raccourcis, préférences, déconnexion.
       Les absences sont désormais une sous-page du profil (plus de 5e onglet). -->
  <template id="portal_profile" name="Profil étudiant">
    <t t-call="school_attendance_qr.portal_shell">
      <t t-set="page_title">Moi</t>
      <t t-set="active_nav">profile</t>

      <header class="topbar" style="padding-bottom:56px; align-items:center; flex-direction:row; gap:14px;">
        <div style="width:62px; height:62px; border-radius:31px; background:var(--accent); color:#fff; display:flex; align-items:center; justify-content:center; font-family:'Source Serif 4',serif; font-size:22px; font-weight:700; flex:none;">
          <t t-esc="(student.prenom or ' ')[0]"/><t t-esc="(student.nom or ' ')[0]"/>
        </div>
        <div>
          <h1 style="font-size:21px;" t-esc="student.name"/>
          <div class="topbar-sub" style="font-size:13px;">Matricule <t t-esc="student.matricule"/><t t-if="student.promotion_id"> · <t t-esc="student.promotion_id.name"/></t></div>
          <t t-if="student.filiere_id"><div class="topbar-sub" style="font-size:12px;" t-esc="student.filiere_id.name"/></t>
        </div>
      </header>

      <div class="page">

        <!-- 3 tuiles : présence, absences, moyenne -->
        <section class="card" style="display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); text-align:center; padding:14px;">
          <t t-set="rate_color" t-value="'var(--ok)' if student.attendance_rate &gt;= 70 else 'var(--bad)'"/>
          <div>
            <div style="font-family:'Source Serif 4',serif; font-size:20px; font-weight:700;" t-att-style="'color:' + rate_color" t-esc="rate_label"/>
            <div style="font-size:11.5px; color:var(--muted);">Présence</div>
          </div>
          <div style="border-left:1px solid var(--line-soft); border-right:1px solid var(--line-soft);">
            <div style="font-family:'Source Serif 4',serif; font-size:20px; font-weight:700;" t-esc="student.sessions_missed"/>
            <div style="font-size:11.5px; color:var(--muted);">Absences</div>
          </div>
          <div>
            <t t-if="moyenne is not None">
              <div style="font-family:'Source Serif 4',serif; font-size:20px; font-weight:700;" t-esc="moyenne"/>
            </t>
            <t t-else="">
              <div style="font-family:'Source Serif 4',serif; font-size:20px; font-weight:700; color:var(--muted);">—</div>
            </t>
            <div style="font-size:11.5px; color:var(--muted);">Moyenne</div>
          </div>
        </section>

        <!-- Raccourcis scolarité -->
        <section class="card-row">
          <a href="/presence/mes-absences" class="list-row">
            <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/><path d="M8 15l2 2 4-4"/></svg></span>
            <div class="main"><div class="title">Mes absences</div></div>
            <span class="sub" style="font-size:12px; color:var(--muted);"><t t-esc="student.sessions_missed"/> séance(s)</span>
            <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </a>
          <a href="/presence/attestations" class="list-row">
            <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 2h8l4 4v16H4V2h4z"/><path d="M8 2v4h4"/></svg></span>
            <div class="main"><div class="title">Attestations de présence</div></div>
            <span class="sub" style="font-size:12px; color:var(--muted);">PDF</span>
            <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </a>
          <t t-if="payment_status">
            <a href="/presence/profil" class="list-row">
              <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg></span>
              <div class="main"><div class="title">Scolarité</div></div>
              <span class="sub" style="font-size:12px; font-weight:600;" t-att-style="'color:' + payment_color" t-esc="payment_status"/>
            </a>
          </t>
        </section>

        <!-- Compte et préférences -->
        <section class="card-row">
          <div class="list-row">
            <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg></span>
            <div class="main"><div class="title">Téléphone enregistré</div></div>
            <t t-if="student.webauthn_credential_id">
              <span style="font-size:12px; font-weight:600; color:var(--ok);">Empreinte active</span>
            </t>
            <t t-else="">
              <span style="font-size:12px; color:var(--muted);">À activer à la 1re confirmation</span>
            </t>
          </div>
          <a href="/presence/mot-de-passe" class="list-row">
            <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span>
            <div class="main"><div class="title">Changer mon mot de passe</div></div>
            <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </a>
          <a href="/presence/notifications" class="list-row">
            <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 16V11a6 6 0 0 1 12 0v5l2 2H4z"/><path d="M10 20a2 2 0 0 0 4 0"/></svg></span>
            <div class="main"><div class="title">Notifications</div></div>
            <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </a>
          <div class="list-row">
            <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3a9 9 0 1 0 9 9c-4 0-9-4-9-9z"/></svg></span>
            <label class="main" for="theme-mode" style="cursor:pointer;"><div class="title">Thème</div></label>
            <select id="theme-mode" class="btn-sm">
              <option value="auto">Automatique</option>
              <option value="light">Clair</option>
              <option value="dark">Sombre</option>
            </select>
          </div>
          <a href="/presence/installer" class="list-row">
            <span class="icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></svg></span>
            <div class="main"><div class="title">Installer sur mon téléphone</div></div>
            <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        </section>

        <a href="/web/session/logout" style="text-align:center; font-size:13.5px; font-weight:600; color:var(--bad); padding:10px;">Se déconnecter</a>

      </div>
      <t t-set="scripts">
        <script type="text/javascript">
          document.addEventListener('DOMContentLoaded', function () {
            var sel = document.getElementById('theme-mode');
            if (!sel) return;
            sel.value = (window.SchoolTheme &amp;&amp; window.SchoolTheme.get()) || 'auto';
            sel.addEventListener('change', function () { if (window.SchoolTheme) window.SchoolTheme.set(sel.value); });
          });
        </script>
      </t>
    </t>
  </template>

</odoo>
