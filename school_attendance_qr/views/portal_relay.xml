<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="portal_relay" name="Relayer des présences">
    <t t-call="school_attendance_qr.portal_shell">
      <t t-set="page_title">Relais</t>

      <header class="topbar">
        <h1>Présences relayées</h1>
        <div class="topbar-sub">Étudiants sans téléphone utilisable</div>
      </header>

      <div class="page">
        <div class="card" style="font-size:12.5px; color:var(--muted); line-height:1.5;">
          L'étudiant saisit <b>lui-même</b> son matricule et son identifiant, puis vous validez avec
          <b>votre</b> empreinte. <b>Chaque relais engage votre identité</b>.
        </div>

        <t t-if="not sessions">
          <div class="card" style="text-align:center; color:var(--muted); padding:28px;">
            Aucune séance ouverte en ce moment.
          </div>
        </t>

        <t t-foreach="sessions" t-as="item">
          <t t-set="session" t-value="item['session']"/>
          <div class="card" style="display:flex; flex-direction:column; gap:12px;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
              <div>
                <div class="eyebrow"><t t-esc="'SORTIE' if item['phase'] == 'checkout' else 'ENTRÉE'"/></div>
                <div class="h-title" style="font-size:18px; margin-top:4px;" t-esc="session.course_id.name"/>
                <div class="h-sub" t-esc="session.room_id.name"/>
              </div>
              <div style="text-align:right; font-size:12px; color:var(--muted);">
                <span class="rl-used" t-att-data-session="session.id" t-esc="item['used']"/> relayé(s)<br/>
                sur <t t-esc="item['limit']"/>
              </div>
            </div>

            <t t-if="session.relay_blocked">
              <p class="ac-result ac-err" style="margin:0;">Relais bloqués : comptage des têtes incohérent.</p>
            </t>
            <t t-elif="not item['students']">
              <div style="font-size:13px; color:var(--muted);">Aucun étudiant sans téléphone à confirmer.</div>
            </t>
            <t t-foreach="item['students']" t-as="st">
              <div class="rl-row" t-att-data-session="session.id" t-att-data-student="st.id"
                   t-att-data-zone="'%s,%s,%s' % (session.room_id.latitude, session.room_id.longitude, session.room_id.radius_meters)"
                   style="border-top:1px solid var(--line-soft); padding-top:10px;">
                <div style="display:flex; align-items:center; justify-content:space-between; gap:10px;">
                  <div style="font-size:14px; font-weight:600;" t-esc="st.name"/>
                  <button type="button" class="rl-open btn-sm">Confirmer</button>
                </div>
                <div class="rl-form" style="display:none; flex-direction:column; gap:8px; margin-top:10px;">
                  <input name="matricule" class="ap-input" placeholder="Matricule (saisi par l'étudiant)" autocomplete="off" inputmode="numeric"/>
                  <input name="identifiant" class="ap-input" placeholder="Identifiant (saisi par l'étudiant)" autocomplete="off" autocapitalize="none"/>
                  <button type="button" class="rl-submit btn-primary">Valider avec mon empreinte</button>
                </div>
                <p class="rl-msg ac-result" style="display:none;"/>
              </div>
            </t>

            <div class="rl-count" t-att-data-session="session.id"
                 style="border-top:1px solid var(--line-soft); padding-top:12px; display:flex; flex-direction:column; gap:8px;">
              <div style="font-size:12.5px; font-weight:600;">Fin de séance : nombre de personnes dans la salle</div>
              <div style="display:flex; gap:8px;">
                <input name="headcount" type="number" min="0" class="ap-input" style="flex:1;" t-att-value="session.headcount_declared or ''"/>
                <button type="button" class="rl-count-submit btn-sm">Enregistrer</button>
              </div>
              <p class="rl-count-msg ac-result" style="display:none;"/>
            </div>
          </div>
        </t>

        <a t-if="holder._name == 'school.student'" href="/presence" style="text-align:center; font-size:13px; color:var(--muted);">Retour à l'accueil</a>
        <a t-else="" href="/odoo" style="text-align:center; font-size:13px; color:var(--muted);">Retour à l'espace enseignant</a>
      </div>

      <t t-set="head">
        <style>
          .ap-input { width:100%; box-sizing:border-box; height:44px; border-radius:10px; border:1px solid var(--line); background:var(--surface); color:var(--ink); padding:0 12px; font-family:inherit; font-size:14px; }
        </style>
      </t>
      <t t-set="scripts">
        <script type="text/javascript" src="/school_attendance_qr/static/src/js/relay.js"></script>
      </t>
    </t>
  </template>

  <template id="portal_relay_denied" name="Relais non autorisé">
    <t t-call="school_attendance_qr.portal_shell">
      <t t-set="page_title">Relais</t>
      <header class="topbar"><h1>Présences relayées</h1></header>
      <div class="page">
        <div class="card" style="text-align:center; color:var(--muted); padding:28px;">
          Seuls les responsables désignés (enseignant du cours ou délégué) peuvent relayer des présences.
        </div>
      </div>
    </t>
  </template>
</odoo>
