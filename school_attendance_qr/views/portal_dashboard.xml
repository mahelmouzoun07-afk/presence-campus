<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Accueil de l'application étudiante. Reprend la maquette :
    - en-tête avec le nom de l'école, la promotion de l'étudiant et la cloche des alertes ;
    - cours en cours avec compte à rebours de la fenêtre et bouton de confirmation ;
    - anneau de présence et moyenne générale ;
    - prochaines échéances ;
    - prochain cours.
    L'inconnu (pas de cours, pas de note, pas d'échéance) est géré par des t-if.
  -->
  <template id="portal_dashboard" name="Accueil étudiant">
    <t t-call="school_attendance_qr.portal_shell">
      <t t-set="page_title">Accueil</t>
      <t t-set="active_nav">home</t>

      <t t-set="initial_bg" t-value="(student.prenom or ' ')[0] + (student.nom or ' ')[0]"/>
      <t t-set="unread" t-value="request.env['school.notification'].sudo().search_count([('user_id', '=', request.env.uid), ('is_read', '=', False)])"/>

      <header class="topbar">
        <div class="topbar-row">
          <div class="school-chip">
            <div class="school-chip-logo" t-esc="initial_bg"/>
            <div class="school-chip-text">
              <b t-esc="request.env.company.name"/>
              <t t-if="student.promotion_id"><span t-esc="student.promotion_id.name"/></t>
            </div>
          </div>
          <a href="/presence/notifications" class="icon-btn" t-attf-aria-label="Alertes, #{unread or 0} nouvelle(s)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 16V11a6 6 0 0 1 12 0v5l2 2H4z"/><path d="M10 20a2 2 0 0 0 4 0"/></svg>
            <span t-if="unread" class="icon-badge" t-esc="unread"/>
          </a>
        </div>
        <div>
          <h1>Bonjour, <t t-esc="student.prenom or student.name"/></h1>
          <p class="topbar-sub"><t t-esc="today_label"/><t t-if="today_count"> · <t t-esc="today_count"/> cours aujourd'hui</t></p>
        </div>
      </header>

      <div class="page">

        <!-- cours en cours -->
        <t t-if="session">
          <section class="card spotlight" style="display:flex; flex-direction:column; gap:12px;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <span class="eyebrow">
                <t t-esc="'SORTIE À CONFIRMER' if phase_hint == 'checkout' else 'ENTRÉE OUVERTE'"/>
              </span>
              <span class="eyebrow bad" id="ac_countdown" t-att-data-close-at="close_at"></span>
            </div>
            <div>
              <div class="h-title" t-esc="session.course_id.name"/>
              <div class="h-sub">
                <t t-esc="session.room_id.name"/> ·
                <t t-esc="request.env['school.attendance.session'].fmt_local(session.time_start, '%Hh%M')"/>
                – <t t-esc="request.env['school.attendance.session'].fmt_local(session.time_end, '%Hh%M')"/>
              </div>
            </div>
            <button type="button" id="ac_seal" class="btn-primary accent" style="height:60px; border-radius:16px;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 11c0 3-1 6-3 8"/><path d="M8 7.5A5 5 0 0 1 17 11c0 2 0 4-1 6"/><path d="M5 10a7 7 0 0 1 2-4.5"/><path d="M12 11v1"/></svg>
              <span class="ac-seal-label"><t t-esc="'Confirmer ma sortie' if phase_hint == 'checkout' else 'Confirmer mon entrée'"/></span>
            </button>
            <p id="ac_result" class="ac-result" style="display:none;"/>
            <p id="ac_result_sub" class="ac-result-sub" style="display:none;"/>
            <div style="font-size:11.5px; color:var(--muted); text-align:center;">Position et appareil vérifiés automatiquement.</div>
          </section>
          <script type="text/javascript">
            document.addEventListener('DOMContentLoaded', function () {
              SchoolAttendance.initConfirmWidget('<t t-esc="token"/>', '<t t-esc="phase_hint"/>');
            });
          </script>
        </t>

        <!-- Pas de cours en ce moment -->
        <t t-elif="next_session">
          <section class="card" style="text-align:center; padding:22px 18px;">
            <div class="eyebrow muted">PROCHAIN COURS</div>
            <div class="h-title" style="margin-top:6px;" t-esc="next_session.course_id.name"/>
            <div class="h-sub" style="margin-top:2px;">
              <t t-esc="next_session.room_id.name"/> ·
              <t t-esc="request.env['school.attendance.session'].fmt_local(next_session.time_start, '%d/%m à %Hh%M')"/>
            </div>
          </section>
        </t>
        <t t-else="">
          <section class="card" style="text-align:center; padding:22px 18px; color:var(--muted);">
            Aucun cours programmé.
          </section>
        </t>

        <!-- 2 tuiles : présence et moyenne -->
        <div style="display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:12px;">
          <a href="/presence/profil" class="card" style="display:flex; flex-direction:column; gap:8px;">
            <span style="font-size:12px; color:var(--muted); font-weight:600;">Présence</span>
            <t t-set="rate" t-value="student.attendance_rate"/>
            <t t-set="rate_color" t-value="'var(--ok)' if rate &gt;= 70 else 'var(--bad)'"/>
            <div style="display:flex; align-items:center; gap:10px;">
              <svg width="46" height="46" viewBox="0 0 46 46" role="img" aria-label="Taux de présence">
                <circle cx="23" cy="23" r="19" fill="none" stroke="var(--line-soft)" stroke-width="5"/>
                <circle cx="23" cy="23" r="19" fill="none" t-att-stroke="rate_color" stroke-width="5" stroke-linecap="round" t-attf-stroke-dasharray="#{rate * 119.4 / 100} 120" transform="rotate(-90 23 23)"/>
              </svg>
              <span style="font-family:'Source Serif 4',serif; font-size:24px; font-weight:700;" t-att-style="'color:' + rate_color" t-esc="rate_label"/>
            </div>
            <span style="font-size:11.5px; color:var(--muted);"><t t-esc="student.sessions_attended"/> sur <t t-esc="student.sessions_expected"/> séances</span>
          </a>
          <a t-att-href="moyenne_link" class="card" style="display:flex; flex-direction:column; gap:8px;">
            <span style="font-size:12px; color:var(--muted); font-weight:600;">Moyenne générale</span>
            <t t-if="moyenne is not None">
              <span style="font-family:'Source Serif 4',serif; font-size:28px; font-weight:700;">
                <t t-esc="moyenne"/><span style="font-size:13px; color:var(--muted); font-family:'IBM Plex Sans',sans-serif;"> /<t t-esc="'%g' % moyenne_scale"/></span>
              </span>
              <t t-if="latest_note">
                <span style="font-size:11.5px; color:var(--ok); font-weight:600;">Nouvelle note : <t t-esc="latest_note"/></span>
              </t>
            </t>
            <t t-else="">
              <span style="font-family:'Source Serif 4',serif; font-size:22px; font-weight:700; color:var(--muted);">—</span>
              <span style="font-size:11.5px; color:var(--muted);">Pas encore de note publiée</span>
            </t>
          </a>
        </div>

        <!-- Échéances à venir -->
        <t t-if="upcoming_events">
          <section class="card tight" style="display:flex; flex-direction:column; gap:10px;">
            <div style="display:flex; justify-content:space-between; align-items:baseline;">
              <span style="font-size:13.5px; font-weight:700;">À venir</span>
              <a href="/presence/calendrier" style="font-size:12.5px; color:var(--accent); font-weight:600;">Tout voir</a>
            </div>
            <t t-foreach="upcoming_events" t-as="ev">
              <div style="display:flex; gap:12px; align-items:center;">
                <div style="width:44px; text-align:center; border-radius:10px; background:var(--line-soft); padding:4px 0; flex:none;">
                  <div style="font-size:10px; color:var(--muted);" t-esc="ev['day_label']"/>
                  <div style="font-weight:700;" t-esc="ev['day_num']"/>
                </div>
                <div style="flex:1; min-width:0;">
                  <div style="font-size:14px; font-weight:600;" t-esc="ev['title']"/>
                  <div style="font-size:12px; color:var(--muted);" t-esc="ev['sub']"/>
                </div>
                <span t-att-class="'dot ' + ev['level']"/>
              </div>
            </t>
          </section>
        </t>

      </div>
    </t>
  </template>

</odoo>
