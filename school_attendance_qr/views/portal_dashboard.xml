<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="portal_dashboard" name="Portail — Tableau de bord">
    <t t-call="school_attendance_qr.portal_layout">
      <t t-set="active_nav">home</t>

      <div class="pp-topbar" style="display:flex; align-items:center; justify-content:space-between;">
        <div class="pp-h1" t-esc="request.env.company.name"/>
        <a href="/presence/profil" aria-label="Mon profil" style="width:34px; height:34px; border-radius:50%; background:rgba(255,255,255,.12); display:flex; align-items:center; justify-content:center;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 5-6 8-6s6.5 2 8 6"/></svg>
        </a>
      </div>

      <div style="padding:22px 20px 24px; flex:1; display:flex; flex-direction:column; gap:18px;">

        <div>
          <div class="pp-h1" style="font-size:21px;">Bonjour, <t t-esc="student.prenom"/></div>
          <div style="color:var(--muted); font-size:13.5px; margin-top:2px;" t-esc="today_label"/>
        </div>

        <t t-if="session and student.no_phone">
          <div class="pp-card" style="text-align:center; font-size:13.5px;">
            <div class="pp-h1" style="font-size:18px;" t-esc="session.course_id.name"/>
            <div style="color:var(--muted); margin-top:6px;">Votre présence est confirmée par le responsable du cours :
              présentez-vous à lui avec votre matricule et votre identifiant.</div>
          </div>
        </t>
        <t t-elif="session">
          <div class="pp-card" style="text-align:center;">
            <div style="color:var(--gold); font-size:12px; font-weight:600; letter-spacing:.03em;">
              <t t-esc="'SORTIE À CONFIRMER' if phase_hint == 'checkout' else 'EN COURS MAINTENANT'"/>
            </div>
            <div class="pp-h1" style="font-size:20px; margin-top:6px;" t-esc="session.course_id.name"/>
            <div style="color:var(--muted); font-size:13.5px; margin-top:3px;">
              <t t-esc="session.room_id.name"/> &#183; <t t-esc="session.time_start.strftime('%Hh%M')"/> – <t t-esc="session.time_end.strftime('%Hh%M')"/>
            </div>

            <div id="ac_seal" class="ac-seal">
              <span class="ac-seal-label"><t t-esc="'Confirmer ma sortie' if phase_hint == 'checkout' else 'Confirmer mon entrée'"/></span>
            </div>
            <p id="ac_result" class="ac-result" style="display:none;"/>
            <p id="ac_result_sub" class="ac-result-sub" style="display:none;"/>
            <div style="color:var(--muted); font-size:11.5px; margin-top:8px;">Position et appareil vérifiés automatiquement.</div>
          </div>
          <script type="text/javascript">
            document.addEventListener('DOMContentLoaded', function () {
              SchoolAttendance.initConfirmWidget('<t t-esc="token"/>', '<t t-esc="phase_hint"/>');
            });
          </script>
        </t>

        <t t-elif="next_session">
          <div class="pp-card" style="text-align:center; padding:26px 18px;">
            <div style="color:var(--muted); font-weight:600; font-size:14px;">Pas de cours en ce moment</div>
            <div style="color:var(--muted); font-size:12.5px; margin-top:4px;">Revenez à l'heure de votre prochain cours pour confirmer votre présence.</div>
          </div>
        </t>
        <t t-else="">
          <div class="pp-card" style="text-align:center; padding:26px 18px;">
            <div style="color:var(--muted); font-weight:600; font-size:14px;">Aucun cours programmé</div>
          </div>
        </t>

        <t t-if="next_session">
          <div class="pp-card" style="display:flex; align-items:center; gap:14px; padding:14px 16px;">
            <div style="width:40px; height:40px; border-radius:10px; background:var(--mist); display:flex; align-items:center; justify-content:center; flex:none;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
            </div>
            <div>
              <div style="font-size:11.5px; color:var(--muted); font-weight:600;">PROCHAIN COURS</div>
              <div style="font-size:14px; font-weight:600; margin-top:1px;">
                <t t-esc="next_session.course_id.name"/> &#183; <t t-esc="next_session.room_id.name"/> &#183; <t t-esc="next_session.time_start.strftime('%Hh%M')"/>
              </div>
            </div>
          </div>
        </t>

        <div class="pp-card">
          <div style="display:flex; align-items:center; justify-content:space-between;">
            <div style="font-size:13.5px; font-weight:600;">Présence ce semestre</div>
            <div t-attf-style="font-size:18px; color:#{'var(--green)' if student.attendance_rate &gt;= 70 else 'var(--brick)'};"><span class="pp-h1" t-esc="rate_label"/></div>
          </div>
          <div style="height:7px; border-radius:4px; background:var(--mist); margin-top:10px; overflow:hidden;">
            <div t-attf-style="height:100%%; width:#{student.attendance_rate}%%; background:#{'var(--green)' if student.attendance_rate &gt;= 70 else 'var(--brick)'};"/>
          </div>
          <div style="color:var(--muted); font-size:12px; margin-top:8px;">
            <t t-esc="student.sessions_attended"/> séances sur <t t-esc="student.sessions_expected"/>
          </div>
        </div>

      </div>
    </t>
  </template>
</odoo>
