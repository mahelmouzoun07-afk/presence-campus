<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="portal_password" name="Portail — Choisir son mot de passe">
    <t t-call="school_attendance_qr.portal_layout">
      <div class="pp-topbar">
        <div class="pp-h1">Choisissez votre mot de passe</div>
      </div>
      <div style="padding:22px 20px 28px; display:flex; flex-direction:column; gap:16px;">
        <div class="pp-card" style="font-size:13.5px; line-height:1.5;">
          <t t-if="forced">
            Bienvenue <b t-esc="student.prenom"/> ! Votre mot de passe actuel est votre <b>matricule</b>, que
            d'autres personnes peuvent connaître. Choisissez-en un nouveau, connu de vous seul.
          </t>
          <t t-else="">Modifiez votre mot de passe.</t>
        </div>
        <form method="post" action="/presence/mot-de-passe" class="pp-card"
              onsubmit="var b = this.querySelector('button[type=submit]'); if (b.disabled) { return false; } b.disabled = true; b.textContent = 'Enregistrement…'; return true;" style="display:flex; flex-direction:column; gap:12px;">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <label style="font-size:12.5px; font-weight:600;">Mot de passe actuel <t t-if="forced">(votre matricule)</t>
            <input type="password" name="old" required="required" autocomplete="current-password" class="form-control mt-1"/>
          </label>
          <label style="font-size:12.5px; font-weight:600;">Nouveau mot de passe (8 caractères minimum)
            <input type="password" name="new1" required="required" minlength="8" autocomplete="new-password" class="form-control mt-1"/>
          </label>
          <label style="font-size:12.5px; font-weight:600;">Confirmez le nouveau mot de passe
            <input type="password" name="new2" required="required" minlength="8" autocomplete="new-password" class="form-control mt-1"/>
          </label>
          <p t-if="error" class="ac-result ac-err" style="margin:0; font-size:13px;" t-esc="error"/>
          <button type="submit" class="btn" style="background:var(--ink); color:#fff; border-radius:10px; padding:11px; font-weight:600;">
            Enregistrer
          </button>
        </form>
      </div>
    </t>
  </template>
</odoo>
