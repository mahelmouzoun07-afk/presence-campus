<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="portal_password" name="Choisir son mot de passe">
    <t t-call="school_attendance_qr.portal_shell">
      <t t-set="page_title">Mot de passe</t>

      <header class="topbar">
        <h1 style="font-size:22px;">Choisissez votre mot de passe</h1>
      </header>

      <div class="page">
        <div class="card">
          <t t-if="forced">
            Bienvenue <b t-esc="student.prenom"/> ! Votre mot de passe actuel est votre <b>matricule</b>, que
            d'autres personnes peuvent connaître. Choisissez-en un nouveau, connu de vous seul.
          </t>
          <t t-else="">Modifiez votre mot de passe.</t>
        </div>
        <form method="post" action="/presence/mot-de-passe" class="card"
              onsubmit="var b = this.querySelector('button[type=submit]'); if (b.disabled) { return false; } b.disabled = true; b.textContent = 'Enregistrement…'; return true;"
              style="display:flex; flex-direction:column; gap:12px;">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <label style="font-size:12.5px; font-weight:600;">Mot de passe actuel <t t-if="forced">(votre matricule)</t>
            <input type="password" name="old" required="required" autocomplete="current-password" class="ap-input"/>
          </label>
          <label style="font-size:12.5px; font-weight:600;">Nouveau mot de passe (8 caractères minimum)
            <input type="password" name="new1" required="required" minlength="8" autocomplete="new-password" class="ap-input"/>
          </label>
          <label style="font-size:12.5px; font-weight:600;">Confirmez le nouveau mot de passe
            <input type="password" name="new2" required="required" minlength="8" autocomplete="new-password" class="ap-input"/>
          </label>
          <p t-if="error" class="ac-result ac-err" style="margin:0; font-size:13px;" t-esc="error"/>
          <button type="submit" class="btn-primary">Enregistrer</button>
        </form>
      </div>

      <t t-set="head">
        <style>
          .ap-input {
            width:100%; box-sizing:border-box; height:44px; border-radius:10px;
            border:1px solid var(--line); background:var(--surface); color:var(--ink);
            padding:0 12px; font-family:inherit; font-size:14px; margin-top:4px;
          }
        </style>
      </t>
    </t>
  </template>
</odoo>
