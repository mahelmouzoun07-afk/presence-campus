<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Études : notes, calendrier, documents, stages. Le lien « Études » est
       déjà dans la nouvelle barre de navigation. Ici on ne définit que les
       sous-pages. -->
  <template id="portal_nav_studies" inherit_id="school_attendance_qr.portal_nav_extra" name="Études — pas d'ajout de nav">
    <xpath expr="." position="inside"/>
  </template>

  <template id="portal_studies_segmented" name="Études — onglets internes">
    <div class="segmented">
      <a href="/presence/notes" t-attf-class="#{'active' if sub == 'notes' else ''}">Notes</a>
      <a href="/presence/calendrier" t-attf-class="#{'active' if sub == 'calendrier' else ''}">Calendrier</a>
      <a href="/presence/documents" t-attf-class="#{'active' if sub == 'documents' else ''}">Documents</a>
      <t t-if="has_internship">
        <a href="/presence/stages" t-attf-class="#{'active' if sub == 'stages' else ''}">Stages</a>
      </t>
    </div>
  </template>

  <template id="portal_studies" name="Études">
    <t t-call="school_attendance_qr.portal_shell">
      <t t-set="page_title">Études</t>
      <t t-set="active_nav">studies</t>

      <header class="topbar">
        <h1>Études</h1>
        <t t-call="school_academic.portal_studies_segmented">
          <t t-set="sub" t-value="'home'"/>
        </t>
      </header>
      <div class="page">
        <section class="card spotlight" style="background:var(--night); color:#fff; display:flex; justify-content:space-between; align-items:flex-end;">
          <div>
            <div style="font-size:12px; color:#C4CAD8;">Moyenne générale</div>
            <div style="font-family:'Source Serif 4',serif; font-size:36px; font-weight:700; line-height:1.1;">
              <t t-esc="general"/><span style="font-size:15px; color:#C4CAD8;"> /<t t-esc="'%g' % scale"/></span>
            </div>
          </div>
        </section>
        <a href="/presence/notes" class="list-row card" style="padding:14px 16px;">
          <span class="icon" style="background:var(--ok-soft); color:var(--ok);"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8l9-4 9 4-9 4-9-4z"/></svg></span>
          <div class="main"><div class="title">Mes notes</div><div class="sub">Détail par cours, bulletin PDF</div></div>
          <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
        </a>
        <a href="/presence/calendrier" class="list-row card" style="padding:14px 16px;">
          <span class="icon" style="background:var(--accent-soft); color:var(--accent);"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg></span>
          <div class="main"><div class="title">Calendrier</div><div class="sub"><t t-esc="len(upcoming)"/> échéance(s) à venir</div></div>
          <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
        </a>
        <a href="/presence/documents" class="list-row card" style="padding:14px 16px;">
          <span class="icon" style="background:var(--info-soft); color:var(--info);"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2h8l4 4v16H4V2h4z"/></svg></span>
          <div class="main"><div class="title">Documents de cours</div><div class="sub"><t t-esc="doc_count"/> fichier(s)</div></div>
          <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
        </a>
        <t t-if="has_internship">
          <a href="/presence/stages" class="list-row card" style="padding:14px 16px;">
            <span class="icon" style="background:var(--warn-soft); color:var(--warn);"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="6" width="16" height="14" rx="2"/><path d="M9 6V4h6v2"/></svg></span>
            <div class="main"><div class="title">Mes stages</div><div class="sub">Garde en cours, heures validées</div></div>
            <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        </t>
      </div>
    </t>
  </template>

  <template id="portal_grades" name="Études — Notes">
    <t t-call="school_attendance_qr.portal_shell">
      <t t-set="page_title">Notes</t>
      <t t-set="active_nav">studies</t>

      <header class="topbar">
        <h1>Études</h1>
        <t t-call="school_academic.portal_studies_segmented">
          <t t-set="sub" t-value="'notes'"/>
        </t>
      </header>

      <div class="page">
        <section class="card spotlight" style="background:var(--night); color:#fff; display:flex; justify-content:space-between; align-items:flex-end;">
          <div>
            <div style="font-size:12px; color:#C4CAD8;" t-esc="period.name or 'Toute l’année'"/>
            <div style="font-family:'Source Serif 4',serif; font-size:36px; font-weight:700; line-height:1.1;">
              <t t-esc="fmt(results['general'])"/><span style="font-size:15px; color:#C4CAD8;"> /<t t-esc="'%g' % results['scale']"/></span>
            </div>
            <div t-if="results['general'] is not None" style="font-size:12.5px; margin-top:4px;" t-attf-style="color:#{'#9ED3B5' if results['passed'] else '#F2A89C'};">
              <t t-esc="'Au-dessus' if results['passed'] else 'En dessous'"/> de la note de passage (<t t-esc="fmt(results['pass_mark'])"/>)
            </div>
          </div>
        </section>

        <t t-if="not results['courses']">
          <div class="card" style="color:var(--muted); text-align:center; padding:28px;">Aucune note publiée pour cette période.</div>
        </t>
        <t t-foreach="results['courses']" t-as="c">
          <section class="card" style="display:flex; flex-direction:column; gap:8px;">
            <div style="display:flex; justify-content:space-between; align-items:baseline;">
              <span style="font-size:15px; font-weight:700;">
                <t t-esc="c['course'].name"/>
                <span style="font-size:11.5px; color:var(--muted); font-weight:500;"> coef. <t t-esc="'%g' % c['coefficient']"/></span>
              </span>
              <span style="font-family:'Source Serif 4',serif; font-size:19px; font-weight:700;" t-esc="fmt(c['average'])"/>
            </div>
            <t t-if="c['average'] is not None">
              <t t-set="width" t-value="min(100, max(0, c['average'] / results['scale'] * 100))"/>
              <t t-set="color" t-value="'var(--ok)' if c['average'] &gt;= results['pass_mark'] else 'var(--bad)'"/>
              <div class="progress"><span t-attf-style="width:#{width}%; background:#{color}"/></div>
            </t>
            <t t-foreach="c['lines']" t-as="line">
              <div style="display:flex; justify-content:space-between; font-size:13px; color:var(--muted);">
                <span><t t-esc="line['evaluation'].name"/></span>
                <span t-if="line['grade'].is_absent">Absent(e)</span>
                <span t-else="" style="font-variant-numeric:tabular-nums;"><t t-esc="fmt(line['grade'].score)"/>/<t t-esc="'%g' % line['evaluation'].max_score"/></span>
              </div>
              <div t-if="line['grade'].comment" style="font-size:12px; font-style:italic; color:var(--muted);" t-esc="line['grade'].comment"/>
            </t>
          </section>
        </t>
        <a t-if="bulletin_allowed and results['courses']" t-attf-href="/presence/notes/bulletin?period_id=#{period.id or ''}" class="btn-outline">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></svg>
          Télécharger mon bulletin (PDF)
        </a>
      </div>
    </t>
  </template>

  <template id="portal_calendar" name="Études — Calendrier">
    <t t-call="school_attendance_qr.portal_shell">
      <t t-set="page_title">Calendrier</t>
      <t t-set="active_nav">studies</t>

      <header class="topbar">
        <h1>Études</h1>
        <t t-call="school_academic.portal_studies_segmented">
          <t t-set="sub" t-value="'calendrier'"/>
        </t>
      </header>

      <div class="page">
        <div style="display:flex; gap:14px; flex-wrap:wrap; font-size:12px; color:var(--muted);">
          <span style="display:flex; align-items:center; gap:5px;"><span class="dot bad"/>Important</span>
          <span style="display:flex; align-items:center; gap:5px;"><span class="dot warn"/>Normal</span>
          <span style="display:flex; align-items:center; gap:5px;"><span class="dot muted"/>Faible</span>
        </div>
        <t t-if="not days">
          <div class="card" style="color:var(--muted); text-align:center; padding:28px;">Rien au calendrier pour le moment.</div>
        </t>
        <t t-foreach="days" t-as="day">
          <div t-attf-style="#{'opacity:.55;' if day[0] &lt; today else ''}">
            <div class="section-label">
              <t t-esc="fmt_date(day[0]).upper()"/><t t-if="day[0] == today"> · AUJOURD'HUI</t>
            </div>
            <t t-foreach="day[1]" t-as="ev">
              <div class="card" style="display:flex; gap:12px; padding:14px; margin-top:8px;">
                <span style="width:4px; border-radius:2px;" t-att-style="'background:' + ({'high':'var(--bad)', 'normal':'var(--warn)', 'low':'var(--muted-soft)'}.get(ev.importance, 'var(--muted-soft)'))"/>
                <div style="flex:1; min-width:0;">
                  <div style="display:flex; justify-content:space-between; gap:8px;">
                    <span style="font-size:14px; font-weight:600;" t-esc="ev.name"/>
                    <span t-if="not ev.all_day" style="font-size:12px; color:var(--muted);" t-esc="request.env['school.attendance.session'].fmt_local(ev.date_start, '%Hh%M')"/>
                  </div>
                  <div style="font-size:12.5px; color:var(--muted);">
                    <t t-esc="event_types[ev.event_type]"/><t t-if="ev.course_id"> · <t t-esc="ev.course_id.name"/></t>
                  </div>
                  <div t-if="ev.description" style="font-size:12.5px; margin-top:3px;" t-esc="ev.description"/>
                </div>
              </div>
            </t>
          </div>
        </t>
      </div>
    </t>
  </template>

  <template id="portal_documents" name="Études — Documents">
    <t t-call="school_attendance_qr.portal_shell">
      <t t-set="page_title">Documents</t>
      <t t-set="active_nav">studies</t>

      <header class="topbar">
        <h1>Études</h1>
        <t t-call="school_academic.portal_studies_segmented">
          <t t-set="sub" t-value="'documents'"/>
        </t>
      </header>

      <div class="page">
        <t t-if="not courses">
          <div class="card" style="color:var(--muted); text-align:center; padding:28px;">Aucun document déposé pour vos cours.</div>
        </t>
        <t t-foreach="courses" t-as="item">
          <div>
            <div class="section-label" t-esc="item[0].name.upper()"/>
            <div class="card-row" style="margin-top:8px;">
              <t t-foreach="item[1]" t-as="doc">
                <div class="list-row">
                  <span class="icon" style="background:var(--bad-soft); color:var(--bad); font-weight:700; font-size:10.5px;" t-esc="(doc.mimetype or '').endswith('pdf') and 'PDF' or 'IMG'"/>
                  <div class="main">
                    <a t-att-href="doc.download_url()" class="title" t-esc="doc.name"/>
                    <div class="sub">
                      <t t-esc="dict(doc._fields['document_type'].selection)[doc.document_type]"/> ·
                      <t t-esc="'%.1f Mo' % (doc.file_size / 1048576.0) if doc.file_size &gt;= 1048576 else '%d Ko' % (doc.file_size // 1024)"/>
                    </div>
                  </div>
                  <button type="button" class="btn-sm dl-offline" t-att-data-url="doc.download_url()">Garder</button>
                </div>
              </t>
            </div>
          </div>
        </t>
      </div>

      <t t-set="scripts">
        <script type="text/javascript">
          document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.dl-offline').forEach(function (btn) {
              btn.addEventListener('click', function () {
                if (!window.SchoolPwa) return;
                btn.textContent = '…';
                window.SchoolPwa.cacheDocument(btn.dataset.url);
              });
            });
            if (navigator.serviceWorker) {
              navigator.serviceWorker.addEventListener('message', function (e) {
                var d = e.data || {};
                var btn = document.querySelector('.dl-offline[data-url="' + d.url + '"]');
                if (btn) btn.textContent = d.type === 'document-cached' ? 'Hors ligne ✓' : 'Échec';
              });
            }
          });
        </script>
      </t>
    </t>
  </template>

</odoo>
