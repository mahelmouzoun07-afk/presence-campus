<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="module_category_school" model="ir.module.category">
    <field name="name">École</field>
    <field name="description">Présence, scolarité et suivi des étudiants.</field>
    <field name="sequence">45</field>
  </record>

  <!-- Enseignant : ne voit que ses propres cours, séances et étudiants -->
  <record id="group_school_teacher" model="res.groups">
    <field name="name">Enseignant</field>
    <field name="category_id" ref="module_category_school"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <!-- Administration : accès complet (secrétariat, direction) -->
  <record id="group_school_admin" model="res.groups">
    <field name="name">Administration</field>
    <field name="category_id" ref="module_category_school"/>
    <field name="implied_ids" eval="[(4, ref('group_school_teacher'))]"/>
  </record>

  <!-- Les administrateurs Odoo sont automatiquement administrateurs de l'école -->
  <record id="base.group_system" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('group_school_admin'))]"/>
  </record>

  <record id="rule_school_course_admin" model="ir.rule">
    <field name="name">Cours : administration, tout</field>
    <field name="model_id" ref="model_school_course"/>
    <field name="groups" eval="[(4, ref('group_school_admin'))]"/>
    <field name="domain_force">[(1, '=', 1)]</field>
  </record>
  <record id="rule_school_course_teacher" model="ir.rule">
    <field name="name">Cours : enseignant, ses cours</field>
    <field name="model_id" ref="model_school_course"/>
    <field name="groups" eval="[(4, ref('group_school_teacher'))]"/>
    <field name="domain_force">[('teacher_id.user_id', '=', user.id)]</field>
  </record>

  <record id="rule_school_student_admin" model="ir.rule">
    <field name="name">Étudiants : administration, tous</field>
    <field name="model_id" ref="model_school_student"/>
    <field name="groups" eval="[(4, ref('group_school_admin'))]"/>
    <field name="domain_force">[(1, '=', 1)]</field>
  </record>
  <record id="rule_school_student_teacher" model="ir.rule">
    <field name="name">Étudiants : enseignant, ses étudiants</field>
    <field name="model_id" ref="model_school_student"/>
    <field name="groups" eval="[(4, ref('group_school_teacher'))]"/>
    <field name="domain_force">[('course_ids.teacher_id.user_id', '=', user.id)]</field>
  </record>

  <record id="rule_school_slot_admin" model="ir.rule">
    <field name="name">Emploi du temps : administration, tout</field>
    <field name="model_id" ref="model_school_timetable_slot"/>
    <field name="groups" eval="[(4, ref('group_school_admin'))]"/>
    <field name="domain_force">[(1, '=', 1)]</field>
  </record>
  <record id="rule_school_slot_teacher" model="ir.rule">
    <field name="name">Emploi du temps : enseignant, ses créneaux</field>
    <field name="model_id" ref="model_school_timetable_slot"/>
    <field name="groups" eval="[(4, ref('group_school_teacher'))]"/>
    <field name="domain_force">['|', ('teacher_id.user_id', '=', user.id), ('course_id.teacher_id.user_id', '=', user.id)]</field>
  </record>

</odoo>
