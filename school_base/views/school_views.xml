<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_school_student_list" model="ir.ui.view">
    <field name="name">school.student.list</field>
    <field name="model">school.student</field>
    <field name="arch" type="xml">
      <list>
        <field name="nom"/><field name="prenom"/><field name="identifiant"/><field name="matricule"/>
        <field name="promotion_id"/><field name="email"/><field name="phone"/><field name="user_id"/>
      </list>
    </field>
  </record>
  <record id="view_school_student_form" model="ir.ui.view">
    <field name="name">school.student.form</field>
    <field name="model">school.student</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_reset_device" type="object" string="Réinitialiser l'appareil (changement de téléphone)"
                  invisible="not device_fingerprint" confirm="Au prochain scan, le nouvel appareil utilisé sera enregistré comme appareil de référence. Continuer ?"/>
          <button name="action_reset_password" type="object" string="Réinitialiser le mot de passe (= matricule)"
                  invisible="not user_id" confirm="Le mot de passe du compte sera remis au matricule de l'étudiant. Vérifiez son identité avant de confirmer. Continuer ?"/>
        </header>
        <sheet>
          <field name="photo" widget="image" class="oe_avatar"/>
          <group>
            <group string="Identité (obligatoire)">
              <field name="nom"/><field name="prenom"/>
              <field name="identifiant"/><field name="matricule"/>
            </group>
            <group string="Coordonnées (optionnel)">
              <field name="email"/><field name="phone"/><field name="birthdate"/>
            </group>
          </group>
          <group>
            <group string="Compte et cours">
              <field name="user_id"/>
              <field name="promotion_id"/>
              <field name="course_ids" widget="many2many_tags"/>
            </group>
            <group string="Sécurité de connexion">
              <field name="device_fingerprint" readonly="1"/>
              <field name="device_bound_at" readonly="1"/>
              <field name="last_login_ip" readonly="1"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_school_course_list" model="ir.ui.view">
    <field name="name">school.course.list</field>
    <field name="model">school.course</field>
    <field name="arch" type="xml">
      <list><field name="name"/><field name="teacher_id"/></list>
    </field>
  </record>
  <record id="action_school_student" model="ir.actions.act_window">
    <field name="name">Élèves</field><field name="res_model">school.student</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_school_course" model="ir.actions.act_window">
    <field name="name">Cours</field><field name="res_model">school.course</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_school_root" name="École" sequence="10"/>
  <menuitem id="menu_school_student" name="Élèves" parent="menu_school_root" action="action_school_student"/>
  <menuitem id="menu_school_course" name="Cours" parent="menu_school_root" action="action_school_course"/>
</odoo>
