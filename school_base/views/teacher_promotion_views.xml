<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_school_teacher_list" model="ir.ui.view">
    <field name="name">school.teacher.list</field>
    <field name="model">school.teacher</field>
    <field name="arch" type="xml">
      <list><field name="name"/><field name="email"/><field name="phone"/><field name="user_id"/></list>
    </field>
  </record>
  <record id="view_school_teacher_form" model="ir.ui.view">
    <field name="name">school.teacher.form</field>
    <field name="model">school.teacher</field>
    <field name="arch" type="xml">
      <form><sheet><group>
        <field name="name"/><field name="email"/><field name="phone"/>
        <field name="user_id"/>
      </group></sheet></form>
    </field>
  </record>
  <record id="action_school_teacher" model="ir.actions.act_window">
    <field name="name">Enseignants</field><field name="res_model">school.teacher</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="view_school_promotion_list" model="ir.ui.view">
    <field name="name">school.promotion.list</field>
    <field name="model">school.promotion</field>
    <field name="arch" type="xml">
      <list editable="bottom"><field name="name"/></list>
    </field>
  </record>
  <record id="action_school_promotion" model="ir.actions.act_window">
    <field name="name">Promotions</field><field name="res_model">school.promotion</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_school_teacher" name="Enseignants" parent="menu_school_root" action="action_school_teacher" sequence="15"/>
  <menuitem id="menu_school_promotion" name="Promotions" parent="menu_school_root" action="action_school_promotion" sequence="16"/>

</odoo>
