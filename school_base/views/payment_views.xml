<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_school_payment_list" model="ir.ui.view">
    <field name="name">school.payment.list</field>
    <field name="model">school.payment</field>
    <field name="arch" type="xml">
      <list>
        <field name="currency_id" column_invisible="1"/>
        <field name="date"/><field name="student_id"/><field name="amount" sum="Total"/>
        <field name="method"/><field name="reference"/><field name="note"/>
      </list>
    </field>
  </record>
  <record id="view_school_payment_form" model="ir.ui.view">
    <field name="name">school.payment.form</field>
    <field name="model">school.payment</field>
    <field name="arch" type="xml">
      <form><sheet><group>
        <group><field name="student_id"/><field name="date"/><field name="currency_id" invisible="1"/><field name="amount"/></group>
        <group><field name="method"/><field name="reference"/><field name="note"/></group>
      </group></sheet></form>
    </field>
  </record>
  <record id="view_school_payment_search" model="ir.ui.view">
    <field name="name">school.payment.search</field>
    <field name="model">school.payment</field>
    <field name="arch" type="xml">
      <search>
        <field name="student_id"/><field name="reference"/>
        <group expand="0" string="Regrouper par">
          <filter string="Étudiant" name="group_student" context="{'group_by': 'student_id'}"/>
          <filter string="Mode de paiement" name="group_method" context="{'group_by': 'method'}"/>
          <filter string="Mois" name="group_month" context="{'group_by': 'date:month'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="action_school_payment" model="ir.actions.act_window">
    <field name="name">Paiements</field><field name="res_model">school.payment</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_school_payment_search"/>
  </record>

  <record id="view_school_fees_list" model="ir.ui.view">
    <field name="groups_id" eval="[(4, ref('school_base.group_school_admin'))]"/>
    <field name="name">school.student.fees.list</field>
    <field name="model">school.student</field>
    <field name="arch" type="xml">
      <list create="0">
        <field name="currency_id" column_invisible="1"/>
        <field name="name"/><field name="matricule"/><field name="promotion_id"/>
        <field name="fees_due" sum="Total dû"/><field name="fees_paid" sum="Total payé"/>
        <field name="fees_balance" sum="Reste à payer"/>
        <field name="payment_status" widget="badge"
               decoration-success="payment_status == 'paid'" decoration-warning="payment_status == 'partial'"
               decoration-danger="payment_status == 'unpaid'" decoration-info="payment_status == 'exempt'"/>
      </list>
    </field>
  </record>
  <record id="view_school_fees_search" model="ir.ui.view">
    <field name="groups_id" eval="[(4, ref('school_base.group_school_admin'))]"/>
    <field name="name">school.student.fees.search</field>
    <field name="model">school.student</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" string="Nom, identifiant ou matricule"
               filter_domain="['|', '|', ('name', 'ilike', self), ('identifiant', 'ilike', self), ('matricule', 'ilike', self)]"/>
        <field name="promotion_id"/>
        <filter string="Impayés" name="unpaid" domain="[('payment_status', '=', 'unpaid')]"/>
        <filter string="Paiement partiel" name="partial" domain="[('payment_status', '=', 'partial')]"/>
        <filter string="À jour" name="paid" domain="[('payment_status', '=', 'paid')]"/>
        <group expand="0" string="Regrouper par">
          <filter string="Situation" name="group_status" context="{'group_by': 'payment_status'}"/>
          <filter string="Promotion" name="group_promotion" context="{'group_by': 'promotion_id'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="action_school_fees" model="ir.actions.act_window">
    <field name="name">Suivi des frais de scolarité</field><field name="res_model">school.student</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_school_fees_list"/>
    <field name="search_view_id" ref="view_school_fees_search"/>
  </record>

  <menuitem id="menu_school_fees_root" name="Scolarité" parent="menu_school_root" sequence="35"
            groups="school_base.group_school_admin"/>
  <menuitem id="menu_school_fees" name="Suivi des frais" parent="menu_school_fees_root"
            action="action_school_fees" sequence="10"/>
  <menuitem id="menu_school_payment" name="Paiements reçus" parent="menu_school_fees_root"
            action="action_school_payment" sequence="20"/>

</odoo>
